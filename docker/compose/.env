# Settings for docker-compose.yml. Copy this folder, edit what you need, then: docker compose up -d --build

# Release to build. Take the version and the two checksums from that release's SHA256SUMS
# (https://github.com/alexberardi/jarvis-server/releases). Change all three together.
JARVISD_VERSION=v0.1.0-rc17
JARVISD_SHA256_AMD64=0980857d6098f5ef7cce7c73b7823fa7659f0081453946a32e5edda1a0a885a4
JARVISD_SHA256_ARM64=a43b0ad00c8b356ebd18725d50da1eaaa1e3fe34846e8cdd1ac4bb4d02afd9a6

# Where the database, models and engines live (several GB once models are downloaded; use fast storage).
JARVIS_DATA=./data

# Host ports. Nodes and phones use the API port; the admin and setup wizard use the admin port.
JARVIS_API_PORT=7700
JARVIS_ADMIN_PORT=7710
JARVIS_MQTT_PORT=1884

TZ=UTC
