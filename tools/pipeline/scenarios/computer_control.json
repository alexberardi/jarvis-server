      }
    ]
  },
  {
    "name": "computer control off: Jarvis, watch me calls start_recording, which says to turn it on",
    "node": "desktop",
    "tools": "../toolsets/desktop.json",
    "home": "none",
    "turns": [
      {
        "say": "Jarvis, watch me",
        "expect": {
