 {
  "name": "desktop: focus the TextEdit window in one turn (#419)",
  "tools": "../toolsets/desktop-windows.json",
  "home": "none",
  "results": {
   "desktop_list_windows": {
    "success": true,
    "windows": [
     {
      "id": "33410/1",
      "title": "alex — zsh",
      "app": "Terminal",
      "minimized": false
     },
     {
      "id": "643/1",
      "title": "Untitled",
      "app": "TextEdit",
      "minimized": false
     },
     {
      "id": "512/1",
      "title": "Inbox",
      "app": "Mail",
      "minimized": false
     }
    ]
   },
   "desktop_window": {
    "success": true,
    "window_id": "643/1",
    "action": "focus",
    "matched_window": "TextEdit — Untitled"
   }
  },
  "turns": [
   {
    "say": "focus the TextEdit window",
    "expect": {
     "tool": "desktop_window",
     "args_match": {
      "window": "(?i)^(643/1|.*text ?-?edit.*)$",
      "action": "^focus$"
     },
     "not_reply": "(?i)didn't work|not found|which window"
    }
   }
  ]
 },
 {
  "name": "desktop: open a file by its name",
  "tools": "../toolsets/desktop.json",
  "home": "none",
  "turns": [
   {
    "say": "open my holiday plans file on my computer",
    "expect": {
     "tool": "desktop_open",
     "args_match": {
      "target": "(?i)holiday"
     },
     "not_call": {
      "tool": "desktop_open",
      "args_match": {
       "target": "[/\\\\\\\\]|^~"
      }
     }
    }
   }
  ],
  "tags": [
   "known-bug"
  ],
  "note": "qwen3.5-9b 2026-11-14: 4/6. desktop_open's description does not mention files: saying so made it 6/6 but cost the window commands (move to a workspace 9/9 -> 4/10)."
 },
