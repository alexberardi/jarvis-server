[
 {
  "name": "desktop: open neovim (voice, app names)",
  "voice": true,
  "tools": "../toolsets/desktop.json",
  "home": "none",
  "turns": [
   {
    "say": "open neovim",
    "expect": {
     "not_heard": "(?i)oven",
     "tool": "desktop_open",
     "args_match": {
      "target": "(?i)neo ?vim"
     }
    }
   }
  ]
 },
 {
  "name": "desktop: NeoVim as a follow-up after another question",
  "tools": "../toolsets/desktop.json",
  "home": "none",
  "turns": [
   {
    "say": "can you open the oven?"
   },
   {
    "say": "NeoVim, can you open it?",
    "expect": {
     "tool": "desktop_open",
     "args_match": {
      "target": "(?i)neo ?vim"
     }
    }
   }
  ]
 },
 {
