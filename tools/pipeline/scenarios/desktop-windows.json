[
  {
    "name": "desktop windows (Hyprland): maximize a named window",
    "tools": "../toolsets/desktop-hyprland.json",
    "home": "none",
    "turns": [
      {
        "say": "maximize firefox",
        "expect": {
          "tool": "desktop_window",
          "args_match": {
            "action": "^maximize$",
            "window": "(?i)firefox"
          }
        }
      }
    ]
  },
