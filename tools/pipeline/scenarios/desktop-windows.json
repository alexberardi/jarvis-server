 {
  "name": "desktop windows (Hyprland): close every window of an app",
  "tools": "../toolsets/desktop-hyprland.json",
  "home": "none",
  "turns": [
   {
    "say": "close all my terminal windows",
    "expect": {
     "tool": "desktop_close_window",
     "args_match": {
      "window_id": "(?i)terminal"
     },
     "args": {
      "all_of_app": true
     }
    }
   }
  ],
  "results": {
   "desktop_list_windows": {
    "success": true,
    "windows": [
     {
      "id": "0xa",
      "title": "build",
      "app": "foot",
      "minimized": false,
      "focused": true
     },
     {
      "id": "0xb",
      "title": "Mozilla Firefox",
      "app": "firefox",
      "minimized": false,
      "focused": false
     },
     {
      "id": "0xc",
      "title": "logs",
      "app": "foot",
      "minimized": false,
      "focused": false
     }
    ]
   }
  },
  "comment": "Listing the windows first is a fine start of the chain; with results, toolbench skips it and the pipeline run checks the close."
 },
