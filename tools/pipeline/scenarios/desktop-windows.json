  {
    "name": "desktop windows (Hyprland): minimize is not here",
    "tools": "../toolsets/desktop-hyprland.json",
    "home": "none",
    "turns": [
      {
        "say": "minimize slack",
        "expect": {
          "tool": "desktop_window",
          "args_match": {
            "action": "^(unsupported|minimize|move_to_monitor|pin|(keep|always)[ _]?on[ _]?top)$"
          }
        }
      }
    ],
    "comment": "Any action not offered here gets the same answer as unsupported (desktop/window.go): the fixed not-supported message."
  },
