 {
  "name": "desktop windows (Hyprland): the island's choice list, then 'the second one'",
  "tools": "../toolsets/desktop-hyprland.json",
  "home": "none",
  "turns": [
   {
    "say": "switch to the terminal",
    "results": {
     "desktop_window": {
      "success": false,
      "error_code": "ambiguous_window",
      "error": "2 windows match \"the terminal\"; ask the user which one they mean (use words from its title)",
      "candidates": [
       "foot — build",
       "foot — logs"
      ],
      "numbered": [
       "foot — build",
       "foot — logs"
      ],
      "island": "Which one?  1. foot — build  2. foot — logs",
      "island_only": true,
      "choice": true
     }
    },
    "expect": {
     "tool": "desktop_window",
     "args_match": {
      "action": "^focus$"
     }
    }
   },
   {
    "say": "the second one",
    "results": {
     "desktop_window": {
      "success": true,
      "action": "focus",
      "window_id": "0xb",
      "matched_window": "foot — logs",
      "island": "Switched to foot",
      "island_only": true
     }
    },
    "expect": {
     "tool": "desktop_window",
     "args_match": {
      "action": "^focus$",
      "window": "(?i)logs|^2$|second"
     }
    }
   }
  ]
 }
]
