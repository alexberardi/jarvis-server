[
  {
    "name": "watches (needs watches.enabled): watch a price",
    "turns": [
      {"say": "let me know when the price on https://www.example.com/item drops below 100 dollars",
       "expect": {"server_tool": "create_watch", "args_match": {"url": "example\\.com", "op": "lt", "value": "100"},
                  "not_reply": "(?i)not sure who|turned off"}}
    ]
  },
  {
    "name": "watches (needs watches.enabled): list",
    "turns": [
      {"say": "what are you watching for me?",
       "expect": {"server_tool": "list_watches", "not_reply": "(?i)not sure who|turned off"}}
    ]
  },
  {
    "name": "watches (needs watches.enabled): cancel",
    "turns": [
      {"say": "stop watching the example price",
       "expect": {"server_tool": "cancel_watch", "not_reply": "(?i)not sure who|turned off"}}
    ]
  },
  {
    "name": "watches (needs watches.enabled): signal",
    "turns": [
      {"say": "tell me when I leave home",
       "expect": {"server_tool": "create_watch", "args_match": {"signal_kind": "presence\\.left"},
                  "not_reply": "(?i)not sure who|turned off"}}
    ]
  }
]
