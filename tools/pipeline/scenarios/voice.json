      }
    },
    "turns": [
      {
        "say": "turn off the oven",
        "expect": {
          "heard": "(?i)\\boven\\b",
          "not_reply": "(?i)(turned|switched) (it |the oven )?off|oven('s| is) (now )?off"
        }
      }
    ]
  },
  {
