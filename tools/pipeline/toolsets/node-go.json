 {
  "type": "function",
  "function": {
   "name": "reminder",
   "description": "Reminders and alarms at a clock time or date ('at 7am', 'wake me up at 6', 'tomorrow at noon'); also list, delete or snooze them. Not for a length of time: use set_timer.",
   "parameters": {
    "type": "object",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "set",
       "list",
       "delete",
       "snooze"
      ]
     },
     "text": {
      "type": "string",
      "description": "What to remind about"
     },
     "resolved_datetimes": {
      "type": "array",
      "description": "Date keys, e.g. tomorrow, next_monday",
      "items": {
       "type": "string",
       "format": "date-time"
      }
     },
     "time": {
      "type": "string",
      "description": "HH:MM, 24h"
     },
     "relative_minutes": {
      "type": "integer",
      "description": "Minutes from now"
     },
     "recurrence": {
      "type": "string",
      "enum": [
       "daily",
       "weekdays",
       "weekly",
       "biweekly",
       "monthly"
      ]
     },
     "filter": {
      "type": "string",
      "enum": [
       "all",
       "today",
       "recurring"
      ]
     },
     "scope": {
      "type": "string",
      "enum": [
       "one",
       "all"
      ]
     },
     "minutes": {
      "type": "integer",
      "description": "Snooze length"
     }
    },
    "required": [
     "action"
    ]
   }
  },
  "allow_direct_answer": false,
  "is_risky": false,
  "keywords": [
   "remind",
   "reminder",
   "reminders",
   "remind me",
   "don't forget",
   "remember to",
   "snooze"
  ],
  "examples": [
   {
    "voice_command": "Remind me to call mom tomorrow at 3 PM",
    "expected_parameters": {
     "action": "set",
     "text": "call mom",
     "resolved_datetimes": [
      "tomorrow"
     ],
     "time": "15:00"
    },
    "is_primary": true
   },
   {
    "voice_command": "Remind me to take out the trash in 30 minutes",
    "expected_parameters": {
     "action": "set",
     "text": "take out the trash",
     "relative_minutes": 30
    },
    "is_primary": false
   },
   {
    "voice_command": "Remind me every day at 8 AM to take my medicine",
    "expected_parameters": {
     "action": "set",
     "text": "take my medicine",
     "time": "08:00",
     "recurrence": "daily"
    },
    "is_primary": false
   },
   {
    "voice_command": "Remind me every Monday at 9 AM to submit my timesheet",
    "expected_parameters": {
     "action": "set",
     "text": "submit my timesheet",
     "resolved_datetimes": [
      "next_monday"
     ],
     "time": "09:00",
     "recurrence": "weekly"
    },
    "is_primary": false
   },
   {
    "voice_command": "Remind me every other Sunday at noon to call grandma",
    "expected_parameters": {
     "action": "set",
     "text": "call grandma",
     "resolved_datetimes": [
      "next_sunday"
     ],
     "time": "12:00",
     "recurrence": "biweekly"
    },
    "is_primary": false
   },
   {
    "voice_command": "What reminders do I have?",
    "expected_parameters": {
     "action": "list"
    },
    "is_primary": false
   },
   {
    "voice_command": "Cancel my reminder to call mom",
    "expected_parameters": {
     "action": "delete",
     "text": "call mom"
    },
    "is_primary": false
   },
   {
    "voice_command": "Snooze for 15 minutes",
    "expected_parameters": {
     "action": "snooze",
     "minutes": 15
    },
    "is_primary": false
   }
  ],
  "antipatterns": [
   {
    "command_name": "set_timer",
    "description": "Short relative-duration countdowns: 'set a timer for 5 minutes', 'timer for 30 seconds', 'countdown from 10', 'wake me up in 5 minutes'."
   }
  ]
 },
