# Real push lane (scripts/e2e mobile --real-push). Copy to ~/.config/jarvis-harness/push.env
# (the default scripts/e2e reads) and fill in, or point $JARVIS_HARNESS_PUSH_ENV at your copy.
# scripts/e2e sources it with bash: set variables win over it. Never commit a filled-in copy.
# What each value must be, and what else the lane needs: docs/dev/e2e.md, "Overnight: real FCM".

# Required: the relay the sandbox registers with, as an http(s) URL that answers from this box.
# The relay holds the Expo push credentials; jarvisd only registers the sandbox's household
# (POST /v1/register). The lane is skipped when it is unset or does not answer at all.
E2E_REAL_RELAY_URL=https://relay.jarvisautomation.io

# Required: the google-services.json of the Firebase project behind the Expo app's FCM
# credentials (the FCM V1 service-account key uploaded in EAS credentials must be from the same
# project). A readable path on this box, absolute or relative to where scripts/e2e runs. It goes
# into the APK build as ./google-services.json; the lane is skipped when it is unset or unreadable.
E2E_PUSH_GOOGLE_SERVICES=/path/to/google-services.json
