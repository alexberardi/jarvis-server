# Contract suite target (scripts/contract.sh). Copy to .contract.env (gitignored) and fill in.
# Never commit real values. See docs/contract/README.md.

# Required: host or IP of the stack under test (legacy Python stack or jarvisd).
JARVIS_CONTRACT_HOST=

# Required for anything that needs fixtures (most tests): jarvis-auth's master admin token
# (JARVIS_AUTH_ADMIN_TOKEN on the target). Used to mint throwaway app clients and nodes.
JARVIS_CONTRACT_AUTH_ADMIN_TOKEN=

# Optional: reuse an existing app client instead of minting a throwaway one per run.
JARVIS_CONTRACT_APP_ID=
JARVIS_CONTRACT_APP_KEY=

# Optional: listeners the target doesn't run (config,auth,logs,command-center,llm,whisper,tts,
# notifications,recipes,ocr), comma-separated. Their tests skip.
JARVIS_CONTRACT_SKIP=

# Optional: per-listener port overrides, JARVIS_CONTRACT_PORT_<LISTENER> with dashes as
# underscores, e.g.
# JARVIS_CONTRACT_PORT_COMMAND_CENTER=17703

# Optional: http (default) or https, and the per-request timeout (Go duration, default 15s).
# JARVIS_CONTRACT_SCHEME=http
# JARVIS_CONTRACT_TIMEOUT=15s

# Optional: command-center's ADMIN_API_KEY on the target. Needed for the CC node fixture
# (POST /api/v0/admin/nodes); without it every cc_* test skips.
JARVIS_CONTRACT_CC_ADMIN_KEY=

# Optional: the target's MQTT broker port (the MBP maps mosquitto to 1884) and the broker
# credential (CC's MQTT_USERNAME / MQTT_PASSWORD; empty = anonymous). Without the port the
# MQTT catalogue test skips.
JARVIS_CONTRACT_MQTT_PORT=
JARVIS_CONTRACT_MQTT_USERNAME=
JARVIS_CONTRACT_MQTT_PASSWORD=
# Optional: user@host:/absolute/path/to/jarvis-whisper-api (no ~: the env file is sourced by bash) — rmdir the empty voice_profiles dir the legacy purge leaves (Python stack only)
JARVIS_CONTRACT_WHISPER_SSH_CLEANUP=
# Optional: "jarvisd" when the target is jarvisd; tests then expect the decided fixes instead of frozen LEGACY-BUGs
JARVIS_CONTRACT_IMPL=
