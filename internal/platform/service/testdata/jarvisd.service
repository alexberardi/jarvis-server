# Written by "jarvisd service install". Local changes are lost on the next install;
# put overrides in "systemctl edit jarvisd" instead.
[Unit]
Description=Jarvis server (jarvisd)
Documentation=https://github.com/alexberardi/jarvis-server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
User=jarvisd
Group=jarvisd
# Self-update (AD5, ID11): the service account can't write the binary, so a privileged
# pre-start ("+": full privileges, no sandbox; "-": never blocks the start) swaps in a release
# the service staged, re-verifying it first, or restores the previous binary for a requested
# rollback. It treats the data directory as untrusted (it must belong to --owner).
Environment=JARVIS_UPGRADE_HELPER=1
ExecStartPre=-+/usr/local/bin/jarvisd upgrade --prestart --home /var/lib/jarvisd --owner jarvisd
ExecStart=/usr/local/bin/jarvisd serve --home /var/lib/jarvisd
Restart=always
# The admin Stop button (AD8b) exits with this code: no restart, and not a failure.
RestartPreventExitStatus=98
SuccessExitStatus=98
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
KillMode=mixed
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvisd
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SyslogIdentifier=jarvisd

[Install]
WantedBy=multi-user.target
