{
  "manifest_version": 3,
  "name": "Jarvis Browser Control",
  "version": "0.3.5",
  "description": "Lets your Jarvis desktop agent manage tabs, read pages, fill fields, click buttons and control media. Talks only to the local agent.",
  "permissions": ["tabs", "scripting", "nativeMessaging", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {"48": "icon-48.png", "128": "icon-128.png"},
  "action": {
    "default_title": "Jarvis Browser Control",
    "default_icon": {"48": "icon-48.png", "128": "icon-128.png"},
    "default_popup": "popup.html"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@jarvis.agent",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
