<?xml version="1.0" encoding="UTF-8"?>
<!-- Task Scheduler exports declare UTF-16; this file is UTF-8 and is installed
     with Register-ScheduledTask -Xml, which takes a string and does not care.
     Do not switch the declaration back without re-encoding the file, or every
     XML parser (including our tests) rejects it. -->
<!--
  A Scheduled Task, deliberately NOT a Windows Service.

  A service runs in Session 0, which has no desktop and no window station. It
  could set the volume and would look healthy, but `open` would launch Steam
  into an invisible session and window enumeration would return nothing. There
  is no flag that fixes this — Session 0 isolation is the point. The task must
  run as the interactive user, triggered at logon.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Jarvis desktop agent - a Jarvis node offering OS control</Description>
    <URI>\Jarvis Automation\net.jarvisautomation.agent</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER_ID__</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER_ID__</UserId>
      <!-- InteractiveToken: run inside the user's desktop session. Never S4U
           or Password, and never the SYSTEM account — those land in Session 0. -->
      <LogonType>InteractiveToken</LogonType>
      <!-- LeastPrivilege: an elevated task cannot send window messages to
           non-elevated apps (UIPI), so running "as admin" would break the very
           window control this exists for. -->
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- An empty ExecutionTimeLimit means "no limit"; the default PT72H would
         silently kill a long-running agent after three days. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__AGENT_BIN__</Command>
      <Arguments>run</Arguments>
    </Exec>
  </Actions>
</Task>
