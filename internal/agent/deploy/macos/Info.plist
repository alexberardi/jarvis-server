<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist of "Jarvis Automation Agent.app", the macOS packaging of jarvis-agent.

  A bundle, not a bare binary: macOS 26 won't list a bare binary added with "+" under
  Privacy & Security → Accessibility, and TCC grants follow the bundle's signed identity
  (CFBundleIdentifier + signing team), so with a stable identity they survive rebuilds.
  LSUIElement: a background agent with no Dock icon. It still runs in the user's GUI session
  (launched by a LaunchAgent in gui/$UID), never as a daemon.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>net.jarvisautomation.agent</string>
    <key>CFBundleName</key>
    <!-- Apple asks for at most 15 characters here; the display name below is the full one. -->
    <string>Jarvis Agent</string>
    <key>CFBundleDisplayName</key>
    <string>Jarvis Automation Agent</string>
    <key>CFBundleExecutable</key>
    <string>jarvis-agent</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <!-- Contents/Resources/AppIcon.icns, made from internal/agent/tray/icon.png by
         scripts/build-macos-apps.sh. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSUIElement</key>
    <true/>
    <!-- jarvis-agent://start (installers plan §6, "Start agent"): opening it starts the agent,
         as opening the app does. The agent never reads anything from the URL. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>net.jarvisautomation.agent.start</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>jarvis-agent</string>
            </array>
        </dict>
    </array>
    <key>NSAppleEventsUsageDescription</key>
    <string>Jarvis Automation Agent asks System Events to list, focus, minimise and close windows when you ask Jarvis to.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Jarvis Automation Agent listens for "hey Jarvis" on this Mac and records what you say next, when voice is turned on.</string>
    <!-- Accessibility and Screen Recording have no usage string macOS shows: their grants are
         switches in System Settings, which the setup page opens. These say what they're for to
         anyone reading the bundle (and to a future macOS that shows them). -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Jarvis Automation Agent types dictated text and moves, focuses and closes windows when you ask Jarvis to.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Jarvis Automation Agent reads the screen when you ask Jarvis what's on it.</string>
    <!-- macOS's Local Network privacy blocks an app from the LAN until it is allowed, silently:
         without these the agent can't reach a server at 10.0.0.x while Terminal can. The Bonjour
         type is the one the server advertises and the setup page browses for. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Jarvis Automation Agent connects to your Jarvis Automation server on your local network, and looks for it there.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_jarvis-config._tcp</string>
    </array>
</dict>
</plist>
