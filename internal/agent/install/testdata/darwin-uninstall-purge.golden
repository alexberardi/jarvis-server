login-item-gone [activate] [ignore-errors] path="/Applications/Jarvis Automation Agent.app" name="net.jarvisautomation.agent.plist"
exec [activate] [ignore-errors] args="launchctl bootout gui/501/net.jarvisautomation.agent"
remove path="~/Library/LaunchAgents/net.jarvisautomation.agent.plist" target="~"
exec [activate] [ignore-errors] path="~/Library/LaunchAgents/io.jarvis.agent.plist" args="launchctl bootout gui/501/io.jarvis.agent"
remove path="~/Library/LaunchAgents/io.jarvis.agent.plist" target="~"
browser-hosts-gone
exec [activate] [ignore-errors] args="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u /Applications/Jarvis Automation Agent.app"
remove-all path="~/Library/Application Support/jarvis-agent"
remove-all path="~/Library/Caches/jarvis-agent"
remove path="~/Library/Logs/jarvis-agent.log"
remove path="~/Library/Logs/jarvis-agent.err.log"
