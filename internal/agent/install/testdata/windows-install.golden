exec [activate] [ignore-errors] args="schtasks /Delete /TN \\Jarvis\\JarvisAgent /F"
reg-set key="Software\\Microsoft\\Windows\\CurrentVersion\\Run" name="Jarvis Automation Agent" value="\"~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe\" run"
reg-set key="Software\\Classes\\jarvis-agent" value="URL:Jarvis Automation Agent"
reg-set key="Software\\Classes\\jarvis-agent" name="URL Protocol"
reg-set key="Software\\Classes\\jarvis-agent\\DefaultIcon" value="\"~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe\",0"
reg-set key="Software\\Classes\\jarvis-agent\\shell\\open\\command" value="\"~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe\" start \"%1\""
shortcut target="~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe" key="Programs" name="Jarvis Automation Agent" args="start"
shortcut target="~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe" key="Desktop" name="Jarvis Automation Agent" args="start"
browser-hosts target="~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe"
start [activate] name="spawn" args="~\\AppData\\Local\\Programs\\Jarvis Agent\\jarvis-agent.exe run"
