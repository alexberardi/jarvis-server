stop [activate] [ignore-errors] key="jarvis-agent.service" name="systemd"
remove path="~/.config/systemd/user/graphical-session.target.wants/jarvis-agent.service" target="~"
remove path="~/.config/systemd/user/default.target.wants/jarvis-agent.service" target="~"
remove path="~/.config/systemd/user/jarvis-agent.service" target="~"
remove path="~/.config/autostart/net.jarvisautomation.agent.desktop" target="~"
remove path="~/.local/share/applications/net.jarvisautomation.agent.desktop" target="~"
remove path="~/Desktop/net.jarvisautomation.agent.desktop"
mime-unset path="~/.config/mimeapps.list" target="~" name="x-scheme-handler/jarvis-agent" value="net.jarvisautomation.agent.desktop"
browser-hosts-gone
remove path="~/.local/lib/jarvis-agent/jarvis-agent" target="~"
exec [activate] [ignore-errors] args="systemctl --user daemon-reload"
exec [activate] [ignore-errors] args="update-desktop-database ~/.local/share/applications"
remove-all path="~/.config/jarvis-agent"
remove-all path="~/.cache/jarvis-agent"
