exec [activate] [ignore-errors] path="~/Library/LaunchAgents/io.jarvis.agent.plist" args="launchctl bootout gui/501/io.jarvis.agent"
remove path="~/Library/LaunchAgents/io.jarvis.agent.plist"
exec [activate] [ignore-errors] path="~/Library/LaunchAgents/net.jarvisautomation.agent.plist" args="launchctl bootout gui/501/net.jarvisautomation.agent"
remove path="~/Library/LaunchAgents/net.jarvisautomation.agent.plist"
login-item [activate] path="/Applications/Jarvis Automation Agent.app" name="net.jarvisautomation.agent.plist"
exec [activate] [ignore-errors] args="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/Jarvis Automation Agent.app"
browser-hosts target="/Applications/Jarvis Automation Agent.app/Contents/MacOS/jarvis-agent"
start [activate] name="launchd" args="launchctl kickstart -k gui/501/net.jarvisautomation.agent"
