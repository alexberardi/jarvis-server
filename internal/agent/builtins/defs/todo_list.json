{
  "client_tool": {
    "allow_direct_answer": false,
    "antipatterns": [
      {
        "command_name": "reminder",
        "description": "Time-based 'remind me to call mom tomorrow' / 'remind me to take out the trash at 8' — those are reminders, not list edits."
      }
    ],
    "examples": [
      {
        "expected_parameters": {
          "action": "add",
          "tasks": [
            "call the dentist"
          ]
        },
        "is_primary": true,
        "voice_command": "Add call the dentist to my to-do list"
      },
      {
        "expected_parameters": {
          "action": "add",
          "tasks": [
            "fold the laundry"
          ]
        },
        "is_primary": false,
        "voice_command": "Put fold the laundry on my to-do list"
      },
      {
        "expected_parameters": {
          "action": "read"
        },
        "is_primary": false,
        "voice_command": "What's on my to-do list?"
      },
      {
        "expected_parameters": {
          "action": "complete",
          "tasks": [
            "the laundry"
          ]
        },
        "is_primary": false,
        "voice_command": "Mark the laundry done on my to-do list"
      },
      {
        "expected_parameters": {
          "action": "uncomplete",
          "tasks": [
            "call the dentist"
          ]
        },
        "is_primary": false,
        "voice_command": "Mark call the dentist as not done on my to-do list"
      },
      {
        "expected_parameters": {
          "action": "remove",
          "tasks": [
            "fold the laundry"
          ]
        },
        "is_primary": false,
        "voice_command": "Remove fold the laundry from my to-do list"
      },
      {
        "expected_parameters": {
          "action": "add",
          "tasks": [
            "walk the dog",
            "buy milk",
            "call the bank"
          ]
        },
        "is_primary": false,
        "voice_command": "Add walk the dog, buy milk, and call the bank to my to-do list"
      },
      {
        "expected_parameters": {
          "action": "clear"
        },
        "is_primary": false,
        "voice_command": "Clear my to-do list"
      },
      {
        "expected_parameters": {
          "action": "clear",
          "scope": "completed"
        },
        "is_primary": false,
        "voice_command": "Clear the completed tasks on my to-do list"
      }
    ],
    "function": {
      "description": "Add to, read, complete or clear the to-do list. Not for timed reminders.",
      "name": "todo_list",
      "parameters": {
        "properties": {
          "action": {
            "enum": [
              "add",
              "read",
              "complete",
              "uncomplete",
              "remove",
              "clear"
            ],
            "type": "string"
          },
          "scope": {
            "description": "For clear: all or completed",
            "enum": [
              "all",
              "completed"
            ],
            "type": "string"
          },
          "tasks": {
            "description": "Whole tasks; don't split on 'and'",
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "is_risky": false,
    "keywords": [
      "to do list",
      "todo list",
      "to-do list",
      "task list",
      "add task",
      "mark done",
      "check off task",
      "to do",
      "todo"
    ],
    "type": "function"
  },
