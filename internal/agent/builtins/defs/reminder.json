{
  "client_tool": {
    "allow_direct_answer": false,
    "antipatterns": [
      {
        "command_name": "set_timer",
        "description": "Short relative-duration countdowns: 'set a timer for 5 minutes', 'timer for 30 seconds', 'countdown from 10', 'wake me up in 5 minutes'."
      }
    ],
    "examples": [
      {
        "expected_parameters": {
          "action": "set",
          "resolved_datetimes": [
            "tomorrow"
          ],
          "text": "call mom",
          "time": "15:00"
        },
        "is_primary": true,
        "voice_command": "Remind me to call mom tomorrow at 3 PM"
      },
      {
        "expected_parameters": {
          "action": "set",
          "relative_minutes": 30,
          "text": "take out the trash"
        },
        "is_primary": false,
        "voice_command": "Remind me to take out the trash in 30 minutes"
      },
      {
        "expected_parameters": {
          "action": "set",
          "recurrence": "daily",
          "text": "take my medicine",
          "time": "08:00"
        },
        "is_primary": false,
        "voice_command": "Remind me every day at 8 AM to take my medicine"
      },
      {
        "expected_parameters": {
          "action": "set",
          "recurrence": "weekly",
          "resolved_datetimes": [
            "next_monday"
          ],
          "text": "submit my timesheet",
          "time": "09:00"
        },
        "is_primary": false,
        "voice_command": "Remind me every Monday at 9 AM to submit my timesheet"
      },
      {
        "expected_parameters": {
          "action": "set",
          "recurrence": "biweekly",
          "resolved_datetimes": [
            "next_sunday"
          ],
          "text": "call grandma",
          "time": "12:00"
        },
        "is_primary": false,
        "voice_command": "Remind me every other Sunday at noon to call grandma"
      },
      {
        "expected_parameters": {
          "action": "list"
        },
        "is_primary": false,
        "voice_command": "What reminders do I have?"
      },
      {
        "expected_parameters": {
          "action": "delete",
          "text": "call mom"
        },
        "is_primary": false,
        "voice_command": "Cancel my reminder to call mom"
      },
      {
        "expected_parameters": {
          "action": "snooze",
          "minutes": 15
        },
        "is_primary": false,
        "voice_command": "Snooze for 15 minutes"
      }
    ],
    "function": {
      "description": "Reminders and alarms at a clock time or date ('at 7am', 'wake me up at 6', 'tomorrow at noon'); also list, delete or snooze them. Not for a length of time: use set_timer.",
      "name": "reminder",
      "parameters": {
        "properties": {
          "action": {
            "enum": [
              "set",
              "list",
              "delete",
              "snooze"
            ],
            "type": "string"
          },
          "filter": {
            "enum": [
              "all",
              "today",
              "recurring"
            ],
            "type": "string"
          },
          "minutes": {
            "description": "Snooze length",
            "type": "integer"
          },
          "recurrence": {
            "enum": [
              "daily",
              "weekdays",
              "weekly",
              "biweekly",
              "monthly"
            ],
            "type": "string"
          },
          "relative_minutes": {
            "description": "Minutes from now",
            "type": "integer"
          },
          "resolved_datetimes": {
            "description": "Date keys, e.g. tomorrow, next_monday",
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "enum": [
              "one",
              "all"
            ],
            "type": "string"
          },
          "text": {
            "description": "What to remind about",
            "type": "string"
          },
          "time": {
            "description": "HH:MM, 24h",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "is_risky": false,
    "keywords": [
