{
  "client_tool": {
    "allow_direct_answer": false,
    "antipatterns": [
      {
        "command_name": "reminder",
        "description": "Time-based 'remind me to buy milk tomorrow' / 'remind me to pick up eggs at 5' — those are reminders, not list edits."
      }
    ],
    "examples": [
      {
        "expected_parameters": {
          "action": "add",
          "items": [
            "milk",
            "eggs"
          ]
        },
        "is_primary": true,
        "voice_command": "Add milk and eggs to the shopping list"
      },
      {
        "expected_parameters": {
          "action": "add",
          "items": [
            "almond butter"
          ]
        },
        "is_primary": false,
        "voice_command": "Put almond butter on the grocery list"
      },
      {
        "expected_parameters": {
          "action": "read"
        },
        "is_primary": false,
        "voice_command": "What's on my shopping list?"
      },
      {
        "expected_parameters": {
          "action": "check_off",
          "items": [
            "milk"
          ]
        },
        "is_primary": false,
        "voice_command": "Check off the milk"
      },
      {
        "expected_parameters": {
          "action": "remove",
          "items": [
            "eggs"
          ]
        },
        "is_primary": false,
        "voice_command": "Remove eggs from the grocery list"
      },
      {
        "expected_parameters": {
          "action": "add",
          "items": [
            "diapers",
            "wipes",
            "bananas"
          ]
        },
        "is_primary": false,
        "voice_command": "Add diapers, wipes, and bananas to the list"
      },
      {
        "expected_parameters": {
          "action": "add",
          "items": [
            "milk"
          ],
          "regular": true
        },
        "is_primary": false,
        "voice_command": "Add milk to the shopping list as a regular"
      },
      {
        "expected_parameters": {
          "action": "clear"
        },
        "is_primary": false,
        "voice_command": "Clear the shopping list"
      },
      {
        "expected_parameters": {
          "action": "clear",
          "scope": "everything"
        },
        "is_primary": false,
        "voice_command": "Clear the shopping list including the regulars"
      }
    ],
    "function": {
      "description": "Add to, read, check off or clear the shopping list.",
      "name": "shopping_list",
      "parameters": {
        "properties": {
          "action": {
            "enum": [
              "add",
              "read",
              "check_off",
              "remove",
              "clear"
            ],
            "type": "string"
          },
          "items": {
            "description": "Item names",
            "type": "array"
          },
          "regular": {
            "description": "Only when the user says regular or staple",
            "type": "boolean"
          },
          "scope": {
            "description": "For clear: trip (default) or everything",
            "enum": [
              "trip",
              "everything"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    "is_risky": false,
    "keywords": [
      "shopping list",
      "grocery list",
      "groceries",
      "shopping",
      "add to list",
      "grocery",
      "check off",
      "need from the store"
    ],
    "type": "function"
  },
