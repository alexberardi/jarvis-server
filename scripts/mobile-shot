#!/usr/bin/env bash
# Screenshots of the mobile app (jarvis-node-mobile, Android) running in a disposable emulator
# against a scripts/sandbox jarvisd. Gives an agent eyes on the app: Read the PNGs, or read the
# UI dumps (uiautomator XML) for the text without vision. See docs/dev/mobile-shots.md.
#
#   scripts/mobile-shot [--sandbox NAME] [--screens LIST] [--themes light,dark]
#                       [--font-scale 1.0,1.3] [--chat TEXT | --no-chat] [--chat-expect RE]
#                       [--pages N] [--keep] [--out DIR] [--ref REF] [--no-fetch] [--rebuild]
#   scripts/mobile-shot deps          check the SDK, create the harness AVD, build the APK
#   scripts/mobile-shot build [--ref REF] [--no-fetch] [--rebuild]  build (or find) the APK, print its path
#   scripts/mobile-shot stop [--sandbox NAME]            kill a --keep emulator
#
#   --sandbox NAME  the scripts/sandbox to log in to (default: mob); it must be up
#   --screens LIST  comma-separated (default: all): landing, login, home, devices, pantry,
#                   routines, nodes, settings, inbox, chat. landing and login are shot logged
#                   out; chat sends one message and waits for the reply.
#   --themes LIST   light, dark (default: both); the emulator's night mode, which the app follows
#   --font-scale L  Android font scales, e.g. 1.0,1.3 (default: 1.0); > 1 catches truncation
#   --chat TEXT     the chat screen's message (default "what is 12 times 7")
#   --chat-expect RE  a regexp the reply must match (default 84 for the default message)
#   --no-chat       skip the chat screen (e.g. a sandbox with --llm none)
#   --pages N       screenfuls per scrolling screen (default 3): scroll and shoot while it moves
#   --keep          leave the emulator running and reuse it next time (boot is the slow part);
#                   scripts/mobile-shot stop kills it
#   --out DIR       default .sandbox/NAME/mobile/<timestamp>/
#   --ref REF       the jarvis-node-mobile commit to build (default: origin/main)
#   --no-fetch      never fetch into the mobile repo (by default --ref origin/main fetches main
#                   first); for a repo someone else keeps up to date, e.g. the loop's mirror
#   --rebuild       ignore the cached APK
#
# Writes <screen>__<theme>[__f<scale>].png, a .xml UI dump beside each, and index.json (per shot:
# visible texts, elements sticking out past the screen, mean luminance and whether it matches
# the theme). Exits 1 if the login or any screen failed, so it doubles as a smoke test.
#
# Isolation: its own AVD (jarvis-harness, under ~/.cache/jarvis-harness/mobile/avd, so it is
# never in the user's AVD list), started -read-only -no-window on a port of its own (5580+); every
# adb call names that emulator's serial, and the EXIT trap kills only that emulator. The APK is
# built from a `git archive` of the mobile repo in ~/.cache, so the user's checkout (and its
# android/ dir) is never touched. JARVIS_MOBILE_REPO may be a checkout, a worktree or a bare
# repo. Concurrent runs share one build dir and take turns on its lock (they wait, never clobber).
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/mobile.sh
. "$ROOT/scripts/lib/mobile.sh"
say() { echo "mobile-shot: $*" >&2; }
die() { say "$*"; exit 1; }
usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }

# --- arguments ----------------------------------------------------------------------------------
CMD=run
case ${1:-} in deps|build|stop) CMD=$1; shift ;; esac
NAME=mob SCREENS= THEMES=light,dark FONTS=1.0 CHAT="what is 12 times 7" EXPECT= NOCHAT=0
OUT= REF=origin/main REBUILD=0 PAGES=3 FETCH=1
while [ $# -gt 0 ]; do
  case $1 in
    --sandbox) NAME=$2; shift 2 ;;
    --screens) SCREENS=$2; shift 2 ;;
    --themes) THEMES=$2; shift 2 ;;
    --font-scale) FONTS=$2; shift 2 ;;
    --chat) CHAT=$2; shift 2 ;;
    --pages) PAGES=$2; shift 2 ;;
    --chat-expect) EXPECT=$2; shift 2 ;;
    --no-chat) NOCHAT=1; shift ;;
    --keep) KEEP=1; shift ;;
    --out) OUT=$2; shift 2 ;;
    --ref) REF=$2; shift 2 ;;
    --rebuild) REBUILD=1; shift ;;
    --no-fetch) FETCH=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown argument $1" ;;
  esac
done
case $NAME in *[!a-zA-Z0-9_-]*|'') die "--sandbox: letters, digits, - and _ only" ;; esac
[ "$(uname -s)" = Linux ] || die "Linux only (Android emulator + KVM); macOS/iOS: docs/dev/mobile-shots.md"
[ -x "$ADB" ] || die "no adb at $ADB (Android SDK platform-tools; set ANDROID_HOME)"
WORK=$ROOT/.sandbox/$NAME/mobile
STATEF=$WORK/emulator.port
mkdir -p "$WORK"

case $CMD in
  deps)
    ensure_avd
    say "AVD: $ANDROID_AVD_HOME/$AVD.avd"
    build_apk "$REF" "$REBUILD" "$FETCH" >/dev/null
    exit 0 ;;
  build) build_apk "$REF" "$REBUILD" "$FETCH"; exit 0 ;;
  stop)
    [ -f "$STATEF" ] || { say "no kept emulator for '$NAME'"; exit 0; }
    PORT=$(cat "$STATEF") SERIAL=emulator-$PORT
    is_ours "$SERIAL" && "$ADB" -s "$SERIAL" emu kill >/dev/null && say "killed $SERIAL"
    [ -f "$WORK/emulator.pid" ] && kill -TERM -- "-$(cat "$WORK/emulator.pid")" 2>/dev/null || true
    rm -f "$STATEF" "$WORK/emulator.pid"
    exit 0 ;;
esac

# --- run ----------------------------------------------------------------------------------------
ENVF=$ROOT/.sandbox/$NAME/sandbox.env
[ -f "$ENVF" ] || die "no sandbox '$NAME'; start one: scripts/sandbox up --name $NAME"
# shellcheck disable=SC1090
source "$ENVF"
curl -sf -o /dev/null "$SBX_CONFIG/services" || die "sandbox '$NAME' isn't answering at $SBX_CONFIG (scripts/sandbox status --name $NAME)"
command -v go >/dev/null || die "go not on PATH"

ensure_avd
T_ALL=$SECONDS
APK=$(build_apk "$REF" "$REBUILD" "$FETCH")
[ -n "$OUT" ] || OUT=$WORK/$(date +%Y%m%d-%H%M%S)
mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)

(cd "$ROOT" && CGO_ENABLED=0 go build -o "$WORK/mobileshot" ./tools/mobileshot)

trap kill_emulator EXIT
trap 'exit 130' INT TERM
boot_emulator
prep_emulator

reverse_sandbox
install_app "$APK"

args=(--adb "$ADB" --serial "$SERIAL" --package "$PKG" --out "$OUT" --email "$SBX_EMAIL" --password "$SBX_PASSWORD"
  --themes "$THEMES" --font-scales "$FONTS" --chat "$CHAT" --pages "$PAGES")
[ -n "$SCREENS" ] && args+=(--screens "$SCREENS")
[ -n "$EXPECT" ] && args+=(--chat-expect "$EXPECT")
[ "$NOCHAT" = 1 ] && args+=(--no-chat)
rc=0
T_RUN=$SECONDS
"$WORK/mobileshot" run "${args[@]}" || rc=1
say "run: $((SECONDS - T_RUN))s, total $((SECONDS - T_ALL))s"
say "screenshots in $OUT (index.json):"
ls "$OUT"/*.png 2>/dev/null | sed 's/^/  /' >&2 || true
exit $rc
