#!/usr/bin/env bash
# A throwaway jarvisd beside the installed one: this checkout's build, its own data directory,
# its own ports, seeded with the dev household, and talking to the installed instance's model
# so it costs no GPU memory. Meant for agents and pipeline tests; every worktree can run its own.
#
#   scripts/sandbox up [--name N] [--offset N] [--profile minimal|rich|empty] [--llm shared|none|scripted] [--ui]
#                      [--voice [--stt-model ID]] [--speech local|fake|speaches] [--sip] [--relay fake|none|URL]
#                      [--lan] [--single-port]
#   scripts/sandbox down [--name N] [--purge]
#   scripts/sandbox status [--name N]      is it up, its URLs, and what holds the GPU
#   scripts/sandbox env [--name N]         print the sandbox's env file (source it in a shell)
#   scripts/sandbox logs [--name N] [-f]
#   scripts/sandbox llm [--name N]         re-point the sandbox at its model again (the mode `up`
#                                          chose; after writing the app client, or a model change)
#   scripts/sandbox list
#   scripts/sandbox node-sim [--name N] [--node-name X]
#                                          a simulated node pairing with a code (below); prints
#                                          the code
#
# up builds ./cmd/jarvisd, starts `jarvisd serve --port-offset N` on .sandbox/<name>/home bound
# to 127.0.0.1 (no mDNS, no browser), runs scripts/seed-dev.py, and writes
# .sandbox/<name>/sandbox.env: every listener URL, the dev users' password, a superuser JWT, the
# seeded kitchen node's id and key, the admin keys, and a login per household role
# (SBX_EMAIL_ADMIN, _POWER, _MEMBER). Running it again on a sandbox that is up
# rebuilds and restarts it on the same data.
#
#   --offset N       port offset (default: the first free of 10000, 11000, ...; kept per name)
#   --profile        seed-dev.py profile (default minimal). empty: no seeding at all, so no
#                    superuser and first-run setup still to do (the setup wizard's E2E test);
#                    sandbox.env then has SBX_SETUP_TOKEN and no logins, and the model is left
#                    as it is (no superuser to set it with)
#   --llm shared     (default) llm.live = the installed jarvisd's live model through its own LLM
#                    API (:7704), so no second model on the GPU; requests queue behind the
#                    house's (one slot). Needs an app client of the installed jarvisd in
#                    ~/.config/jarvis-harness/installed.env (INSTALLED_APP_ID, INSTALLED_APP_KEY).
#                    Calls go through the tap (tools/pipeline tap, port 7799 + offset), which
#                    logs every model call to .sandbox/<name>/llm.jsonl.
#   --llm none       no model: everything but the LLM works
#   --llm scripted   a deterministic model for UI tests: tools/scriptllm (port 7798 + offset, behind
#                    the tap) answers from e2e/llm/default.json; needs no installed jarvisd. Tests
#                    switch scripts at $SBX_SCRIPTLLM/control/script (docs/decisions/2026-10-17-scripted-llm.md)
#   --ui             build the admin SPA first (npm, with the /dev/ui gallery) and serve it; otherwise web/admin/dist/ui
#                    is served when it exists, else the built-in placeholder page
#   --voice          real TTS and STT, for voice pipeline runs (pipeline say --voice): Kokoro,
#                    the speaker model and a whisper model, downloaded once into
#                    ~/.cache/jarvis-harness/models ($JARVIS_HARNESS_CACHE) and used in place;
#                    whisper-server runs on the CPU (stt.gpu_backend cpu, gpu_layers 0), never
#                    the GPU the installed jarvisd uses. The CPU build is fetched on first use.
#   --stt-model ID   the catalog's stt model for --voice (default whisper-small.en; base.en is
#                    faster and mishears more; whisper-large-v3-turbo-q5_0 is better and slower)
#   --speech local   (default) STT on the local whisper-server (--voice) or off
#   --speech fake    STT is remote (stt.engine=remote, docs/llm/07-remote-speech.md): tools/fakespeech
#                    (port 7796 + offset) answers every clip with canned text and records each request
#                    at $SBX_FAKESPEECH/control/requests (canned text: POST /control/text; failures:
#                    POST /control/fail). For the contract suite; voice scenarios mishear on purpose
#   --speech speaches  STT is remote on speaches (an OpenAI-compatible server) in Docker (port 7795 +
#                    offset, the "Other" preset), so pipeline say|run --voice round-trips through a real
#                    remote; with --voice. Model $SPEACHES_STT_MODEL (default Systran/faster-whisper-small.en,
#                    local's size; a distil model copies a desktop node's vocabulary prompt into the
#                    transcript), cached in ~/.cache/jarvis-harness/speaches. down removes it
#   --sip            the L1 SIP lane beside it (scripts/sip-lane, docs/cc/phone-sip.md §5): Asterisk 22
#                    in Docker configured like FreePBX 17, baresip far ends, ports offset like the
#                    sandbox's; sandbox.env gets SBX_SIP_LANE (its lane.env). Its scenarios:
#                    go run ./tools/siplane --sandbox N (needs --voice too). down removes it
#   --relay fake     (default) push notifications go to tools/fakerelay (port 7797 + offset), which
#                    records every push instead of sending it: $SBX_FAKERELAY/control/pushes
#                    (docs/decisions/2026-10-18-e2e-push.md); pushes also land in .sandbox/<name>/pushes.jsonl
#   --relay none     no relay: pushes are logged as skipped, as on an install without one
#   --relay URL      a real relay (e.g. https://relay.jarvisautomation.io): pushes reach real
#                    phones through Expo. Only for scripts/e2e mobile --real-push
#   --version V      the version jarvisd reports (default dev-sandbox); a release tag such as
#                    v1.2.0 makes the release-matching paths (the agent download) testable
#   --trust-key K    also trust this minisign public key (a test build, as scripts/upgrade-e2e.sh
#                    does; never the project's). With JARVIS_UPDATE_API (or JARVISD_RELEASE_BASE)
#                    in the environment of `up`, jarvisd reads a fake release signed with it
#
#   --single-port    jarvisd as a fresh install runs it: legacy ports off (JARVIS_LEGACY_PORTS=0),
#                    so only config (7700), admin (7710) and MQTT (1884) listen, and every other
#                    service is under its path on the config port: SBX_CC is
#                    http://127.0.0.1:<7700+offset>/cc and so on. Without it jarvisd runs with
#                    JARVIS_LEGACY_PORTS=1, every service on its own port as before. Kept per name
#                    until the next up
#   --lan            listen on every interface instead of 127.0.0.1 (jarvisd, the scripted
#                    model and the fake relay), for a device on another machine: the iOS lane's
#                    simulator on the Mac (scripts/e2e ios). The dev box's LAN address (or
#                    $JARVIS_LAN_HOST) goes into sandbox.env as SBX_LAN_HOST and SBX_LAN_CONFIG,
#                    and .sandbox/<name>/sandbox-lan.env is sandbox.env with every URL on that
#                    address but the LLM tap (loopback only), for the other machine. The seeded
#                    logins and keys are open to the LAN while it is up: take it down after.
# node-sim builds ./cmd/jarvis-agent and runs the real agent headless as a Pi node (--profile pi,
# voice off, no auto-update) with its own HOME under .sandbox/<name>/simnode/<X>/: `enroll --code`
# against the sandbox, so a pending pairing appears for the admin's Nodes page or the app to
# approve. It prints the pairing code on stdout once the agent shows it (and writes it to
# simnode/<X>/code, for Maestro), answers yes to the agent's "Join this household?" once
# approved, then stays up as `jarvis-agent run` (heartbeats, MQTT) until down. --node-name
# (default sim-node) is the name the pairing asks for; one agent per name. Log: simnode/<X>/agent.log.
#
# Nodes may claim who is speaking (JARVIS_DEV_SPEAKER_HINTS=1), standing in for voice ID.
# Without --voice (or --speech), STT is off and TTS has no voice models: pipeline tests start from text
# (go run ./tools/pipeline say "turn on the kitchen lights"; ... run for the scenarios).
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SBX_ROOT=$ROOT/.sandbox
say() { echo "sandbox: $*" >&2; }
# shellcheck source=lib/go.sh
. "$ROOT/scripts/lib/go.sh"
die() { say "$*"; exit 1; }

CMD=${1:-}
[ -n "$CMD" ] || { sed -n '2,100p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
shift
NAME=default OFFSET= PROFILE=minimal LLM= UI=0 PURGE=0 FOLLOW=0 VOICE=0 STT_MODEL=whisper-small.en SIP=0
VERSION=dev-sandbox TRUST_KEY= RELAY=fake NODE_NAME=sim-node LAN=0 LAN_HOST="" SINGLE_PORT=0 SPEECH=local
while [ $# -gt 0 ]; do
  case $1 in
    --name) NAME=$2; shift 2 ;;
    --offset) OFFSET=$2; shift 2 ;;
    --profile) PROFILE=$2; shift 2 ;;
    --llm) LLM=$2; shift 2 ;;
    --ui) UI=1; shift ;;
    --voice) VOICE=1; shift ;;
    --sip) SIP=1; shift ;;
    --speech) SPEECH=$2; shift 2 ;;
    --stt-model) STT_MODEL=$2; shift 2 ;;
    --version) VERSION=$2; shift 2 ;;
    --trust-key) TRUST_KEY=$2; shift 2 ;;
    --relay) RELAY=$2; shift 2 ;;
    --lan) LAN=1; shift ;;
    --single-port) SINGLE_PORT=1; shift ;;
    --purge) PURGE=1; shift ;;
    --node-name) NODE_NAME=$2; shift 2 ;;
    -f) FOLLOW=1; shift ;;
    -h|--help) sed -n '2,100p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
done
case $NAME in *[!a-zA-Z0-9_-]*|'') die "--name: letters, digits, - and _ only" ;; esac
case $NODE_NAME in *[!a-zA-Z0-9_-]*|'') die "--node-name: letters, digits, - and _ only" ;; esac
case $LLM in '' | shared | none | scripted) ;; *) die "--llm: shared, none or scripted" ;; esac
case $PROFILE in minimal | rich | empty) ;; *) die "--profile: minimal, rich or empty" ;; esac
case $RELAY in fake | none | http://* | https://*) ;; *) die "--relay: fake, none or an http(s) URL" ;; esac
case $SPEECH in local | fake | speaches) ;; *) die "--speech: local, fake or speaches" ;; esac

DIR=$SBX_ROOT/$NAME
HOME_DIR=$DIR/home
PIDFILE=$DIR/jarvisd.pid
LOG=$DIR/jarvisd.log
ENVF=$DIR/sandbox.env
LANENVF=$DIR/sandbox-lan.env
OFFSETF=$DIR/offset
TAPPID=$DIR/tap.pid
SCRIPTPID=$DIR/scriptllm.pid
RELAYPID=$DIR/fakerelay.pid
SPEECHPID=$DIR/fakespeech.pid
SPEACHES=jarvis-sbx-$NAME-speaches
SPEACHES_IMAGE=${SPEACHES_IMAGE:-ghcr.io/speaches-ai/speaches:latest-cpu}
SPEACHES_STT_MODEL=${SPEACHES_STT_MODEL:-Systran/faster-whisper-small.en}
LLMF=$DIR/llm-mode
SINGLEF=$DIR/single-port

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
tap_running() { [ -f "$TAPPID" ] && kill -0 "$(cat "$TAPPID")" 2>/dev/null; }
scriptllm_running() { [ -f "$SCRIPTPID" ] && kill -0 "$(cat "$SCRIPTPID")" 2>/dev/null; }
relay_running() { [ -f "$RELAYPID" ] && kill -0 "$(cat "$RELAYPID")" 2>/dev/null; }
speech_running() { [ -f "$SPEECHPID" ] && kill -0 "$(cat "$SPEECHPID")" 2>/dev/null; }
# port_busy: is something listening on TCP port $1? ss on Linux, lsof where there is no ss (macOS).
port_busy() {
  if command -v ss >/dev/null; then
    ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
  else
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  fi
}
# detach runs a command as its own session and process-group leader, so `down` can kill the whole
# group (kill -- -PID). setsid(1) is Linux-only; elsewhere (macOS) perl's POSIX::setsid does the
# same. It execs, so call it only in the background (`detach cmd ... &`): $! is then the leader.
detach() {
  if command -v setsid >/dev/null; then exec setsid "$@"; fi
  exec perl -MPOSIX -e 'POSIX::setsid() or die "setsid: $!\n"; exec @ARGV or die "exec $ARGV[0]: $!\n"' -- "$@"
}
port() { echo $(($1 + $(cat "$OFFSETF"))); }
# svc_url is a listener's base URL: its own port, or with --single-port (as the sandbox was last
# brought up) its path on the config port.
svc_url() {
  local l=$1 p prefix
  case $l in
    config) p=7700 ;; auth) p=7701 prefix=/auth ;; logs) p=7702 prefix=/logs ;; cc) p=7703 prefix=/cc ;;
    llm) p=7704 prefix=/llm ;; whisper) p=7706 prefix=/stt ;; tts) p=7707 prefix=/tts ;;
    notifications) p=7712 prefix=/notifications ;; recipes) p=7030 prefix=/recipes ;; ocr) p=7031 prefix=/ocr ;;
    admin) p=7710 ;;
    *) die "svc_url: unknown listener $l" ;;
  esac
  if [ -f "$SINGLEF" ] && [ -n "${prefix:-}" ]; then
    echo "http://127.0.0.1:$(port 7700)$prefix"
  else
    echo "http://127.0.0.1:$(port $p)"
  fi
}
json() { python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"; }

# The installed jarvisd's LLM API, reached with an app client of its own (created once in its
# admin, Connections → App clients). Kept outside the repo so every worktree shares it:
#   INSTALLED_LLM_URL=http://127.0.0.1:7704     (optional; the default)
#   INSTALLED_LLM_LABEL=live                    (optional; live or background: which of its
#                                                chat labels the sandbox's live label calls)
#   INSTALLED_APP_ID=claude-harness
#   INSTALLED_APP_KEY=...
CREDS=${JARVIS_HARNESS_ENV:-$HOME/.config/jarvis-harness/installed.env}
load_creds() {
  INSTALLED_LLM_URL=http://127.0.0.1:7704 INSTALLED_LLM_LABEL=live INSTALLED_APP_ID= INSTALLED_APP_KEY=
  # shellcheck disable=SC1090
  [ -f "$CREDS" ] && . "$CREDS"
  case $INSTALLED_LLM_LABEL in live | background) ;; *) die "INSTALLED_LLM_LABEL must be live or background, not '$INSTALLED_LLM_LABEL'" ;; esac
  [ -n "$INSTALLED_APP_ID" ] && [ -n "$INSTALLED_APP_KEY" ]
}

# installed_model prints the id, window and vision flag of the model behind the installed
# jarvisd's $INSTALLED_LLM_LABEL, from its unauthenticated /v1/models. That lists live, then
# background, with one entry when both labels share an engine, so background is the last one.
installed_model() {
  curl -sf -m 5 "$INSTALLED_LLM_URL/v1/models" | python3 -c '
import json, sys
d = json.load(sys.stdin)["data"]
if d:
    m = d[-1] if sys.argv[1] == "background" else d[0]
    print(m["id"], m.get("context_length") or 0, "true" if m.get("supports_images") else "false")' "${INSTALLED_LLM_LABEL:-live}"
}

pick_offset() {
  if [ -n "$OFFSET" ]; then echo "$OFFSET"; return; fi
  if [ -f "$OFFSETF" ]; then cat "$OFFSETF"; return; fi
  local taken=" " o
  for f in "$SBX_ROOT"/*/offset; do [ -f "$f" ] && taken+="$(cat "$f") "; done
  for o in $(seq 10000 1000 40000); do
    case $taken in *" $o "*) continue ;; esac
    port_busy $((7700 + o)) || port_busy $((7703 + o)) || port_busy $((7710 + o)) || { echo "$o"; return; }
  done
  die "no free port offset"
}

set_setting() { # listener key json-value
  local code
  code=$(curl -s -o "$DIR/.put" -w '%{http_code}' -X PUT "$(svc_url "$1")/settings/$2" \
    -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' -d "{\"value\": $3}")
  [ "$code" = 200 ] || die "PUT $2 → $code: $(cat "$DIR/.put")"
}

login() {
  curl -sf -X POST "$(svc_url auth)/auth/login" -H 'Content-Type: application/json' \
    -d '{"email":"test@jarvisautomation.io","password":"DevPass123!"}' | json 'd["access_token"]'
}

point_llm() {
  TOKEN=$(login) || die "login failed"
  local llm=llm cc=cc
  if [ "$LLM" = none ]; then
    set_setting "$llm" llm.live.engine '"off"'
    say "llm: off"
    return
  fi
  if [ "$LLM" = scripted ]; then
    point_scripted
    return
  fi
  if ! load_creds; then
    set_setting "$llm" llm.live.engine '"off"'
    say "llm: off. No app client for the installed jarvisd in $CREDS."
    say "     Create one in its admin (Connections → App clients, e.g. claude-harness) and write"
    say "     INSTALLED_APP_ID=... and INSTALLED_APP_KEY=... there (chmod 600), then: scripts/sandbox llm"
    return
  fi
  local model
  model=$(installed_model) || { set_setting "$llm" llm.live.engine '"off"'; say "llm: off. $INSTALLED_LLM_URL/v1/models lists no model (is the installed jarvisd up?)"; return; }
  read -r alias ctx vision <<<"$model"
  # Through the tap (tools/pipeline), which logs every call to llm.jsonl and adds the app
  # credentials, to the installed jarvisd's own LLM API: its $INSTALLED_LLM_LABEL label, its GPU engine, its
  # chat template and system-message folding (so folding is off here).
  set_setting "$llm" llm.live.engine '"remote"'
  set_setting "$llm" llm.live.remote_url "\"http://127.0.0.1:$(port 7799)/v1\""
  set_setting "$llm" llm.live.remote_api '"openai"'
  set_setting "$llm" llm.live.remote_model "\"$INSTALLED_LLM_LABEL\""
  set_setting "$llm" llm.live.context "$ctx"
  set_setting "$llm" llm.live.remote_vision "$vision"
  set_setting "$llm" llm.live.fold_system_messages '"off"'
  set_setting "$llm" llm.background.engine '"shared"'
  set_setting "$llm" llm.embeddings.engine '"off"'
  # A household with voice ID: the memory tools are offered (D3/D21) and refuse an unknown
  # speaker when called; pipeline turns name the speaker through dev speaker hints.
  set_setting whisper voice.recognition_enabled true
  # The prompt provider a local install takes from the model's catalog entry.
  local provider
  provider=$(python3 -c '
import json, sys
for e in json.load(open(sys.argv[1])):
    if e["id"] == sys.argv[2]:
        print(e.get("prompt_provider", ""))
        break' "$ROOT/internal/modules/llm/models/catalog.json" "$alias")
  if [ -n "$provider" ]; then
    set_setting "$cc" llm.prompt_provider "\"$provider\""
  else
    say "llm: $alias is not in the catalog; set llm.prompt_provider by hand"
  fi
  # The LLM mode. Through the tap the sandbox's live label is remote, which resolves to native
  # with no suffix, so set the mode that provider's model talked in before prompts became text
  # (the Qwen 8B/14B prompts: text + suffix; the 9B's: native + suffix). That keeps the
  # sandbox's model calls those of main for the same model. SANDBOX_TOOL_CALLING (native, text,
  # auto) and SANDBOX_THINKING_SWITCH (suffix, none, auto) choose another, e.g. to measure the
  # mode a local install detects from the model's template.
  local tc=auto th=auto
  case $provider in
    Qwen3_5_9B*) tc=native th=suffix ;;
    Qwen3_*) tc=text th=suffix ;;
  esac
  tc=${SANDBOX_TOOL_CALLING:-$tc} th=${SANDBOX_THINKING_SWITCH:-$th}
  set_setting "$cc" llm.tool_calling "\"$tc\""
  set_setting "$cc" llm.thinking_switch "\"$th\""
  say "llm: tap :$(port 7799) → installed jarvisd $INSTALLED_LLM_URL ($INSTALLED_LLM_LABEL = $alias); mode $tc/$th; calls logged to $DIR/llm.jsonl"
}

# point_scripted makes llm.live the scripted model (tools/scriptllm) through the tap, so model
# calls still land in llm.jsonl. Native tool calls with no thinking switch: cc sends the tools
# and reads the OpenAI tool_calls the script returns, so no prompt format is involved. The prompt
# provider is a fixed catalog one (a remote model derives none).
point_scripted() {
  local llm=llm cc=cc
  scriptllm_running || { tail -5 "$DIR/scriptllm.log" >&2; die "scriptllm is not running (log: $DIR/scriptllm.log)"; }
  set_setting "$llm" llm.live.engine '"remote"'
  set_setting "$llm" llm.live.remote_url "\"http://127.0.0.1:$(port 7799)/v1\""
  set_setting "$llm" llm.live.remote_api '"openai"'
  set_setting "$llm" llm.live.remote_model '"scripted"'
  set_setting "$llm" llm.live.context 32768
  set_setting "$llm" llm.live.remote_vision false
  set_setting "$llm" llm.live.fold_system_messages '"off"'
  set_setting "$llm" llm.background.engine '"shared"'
  set_setting "$llm" llm.embeddings.engine '"off"'
  set_setting whisper voice.recognition_enabled true
  set_setting "$cc" llm.prompt_provider '"Qwen3_5_9B_Compressed"'
  set_setting "$cc" llm.tool_calling '"native"'
  set_setting "$cc" llm.thinking_switch '"none"'
  say "llm: tap :$(port 7799) → scripted model :$(port 7798) ($(curl -sf "http://127.0.0.1:$(port 7798)/control/script" | json 'd["script"]')); unmatched turns in $DIR/scriptllm-unmatched.jsonl"
}

# Voice models live in one cache shared by every worktree and sandbox; the sandbox's settings
# point at them by absolute path, so nothing is copied and down --purge keeps them.
CACHE=${JARVIS_HARNESS_CACHE:-$HOME/.cache/jarvis-harness}/models
fetch_voice_models() {
  local r=https://github.com/k2-fsa/sherpa-onnx/releases/download
  mkdir -p "$CACHE"
  if [ ! -d "$CACHE/kokoro-multi-lang-v1_0" ]; then
    say "voice: downloading Kokoro (350 MB, once)"
    rm -rf "$CACHE.tmp" && mkdir -p "$CACHE.tmp"
    curl -fsSL "$r/tts-models/kokoro-multi-lang-v1_0.tar.bz2" | tar xj -C "$CACHE.tmp" || die "voice: Kokoro download failed"
    mv "$CACHE.tmp/kokoro-multi-lang-v1_0" "$CACHE/" && rm -rf "$CACHE.tmp"
  fi
  local spk=3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx
  if [ ! -f "$CACHE/$spk" ]; then
    curl -fsSL -o "$CACHE/$spk.part" "$r/speaker-recongition-models/$spk" || die "voice: speaker model download failed"
    mv "$CACHE/$spk.part" "$CACHE/$spk"
  fi
  # The whisper model, as the catalog pins it (repo, revision, file, sha256).
  local entry url sum file
  entry=$(python3 -c '
import json, sys
for e in json.load(open(sys.argv[1])):
    if e["id"] == sys.argv[2] and e.get("kind") == "stt":
        print("https://huggingface.co/%s/resolve/%s/%s" % (e["repo"], e["revision"], e["file"]), e["sha256"], e["file"])
        break' "$ROOT/internal/modules/llm/models/catalog.json" "$STT_MODEL")
  [ -n "$entry" ] || die "--stt-model $STT_MODEL: not an stt model in the catalog"
  read -r url sum file <<<"$entry"
  if [ ! -f "$CACHE/$file" ]; then
    say "voice: downloading $file (once)"
    curl -fsSL -o "$CACHE/$file.part" "$url" || die "voice: download of $url failed"
    echo "$sum  $CACHE/$file.part" | sha256sum -c --quiet - || { rm -f "$CACHE/$file.part"; die "voice: $file: sha256 mismatch"; }
    mv "$CACHE/$file.part" "$CACHE/$file"
  fi
  STT_FILE=$CACHE/$file
}

# setup_remote_stt points the stt label at the --speech remote, as a superuser would with the
# "Other" preset (docs/llm/07-remote-speech.md): tools/fakespeech (started by up) or speaches in
# Docker, started here (the first run pulls its image and model into the harness cache).
setup_remote_stt() {
  local llm=llm url model key=
  case $SPEECH in
    fake)
      url=http://127.0.0.1:$(port 7796)/v1 model=fake-transcribe key=$(cat "$DIR/fakespeech-key") ;;
    speaches)
      start_speaches
      url=http://127.0.0.1:$(port 7795)/v1 model=$SPEACHES_STT_MODEL ;;
  esac
  set_setting "$llm" stt.remote_url "\"$url\""
  set_setting "$llm" stt.remote_api '"openai"'
  set_setting "$llm" stt.remote_model "\"$model\""
  set_setting "$llm" stt.remote_api_key "\"$key\""
  # The first speaches transcription loads the model: give it longer than a voice turn's 8 s.
  [ "$SPEECH" != speaches ] || set_setting "$llm" stt.remote_timeout_ms 60000
  set_setting "$llm" stt.engine '"remote"'
  say "stt: remote, $url ($model)"
}

start_speaches() {
  command -v docker >/dev/null && docker info >/dev/null 2>&1 || die "--speech speaches needs Docker (docker info failed)"
  local cache=${JARVIS_HARNESS_CACHE:-$HOME/.cache/jarvis-harness}/speaches p
  p=$(port 7795)
  mkdir -p "$cache"
  docker rm -f "$SPEACHES" >/dev/null 2>&1 || true
  say "speaches: starting $SPEACHES_IMAGE on :$p (the first run pulls the image)"
  docker run -d --name "$SPEACHES" --label jarvis-sandbox="$NAME" -p "127.0.0.1:$p:8000" \
    -v "$cache:/home/ubuntu/.cache/huggingface/hub" "$SPEACHES_IMAGE" >/dev/null || die "docker run $SPEACHES failed"
  for _ in $(seq 1 120); do
    curl -sf "http://127.0.0.1:$p/health" >/dev/null && break
    docker inspect -f '{{.State.Running}}' "$SPEACHES" 2>/dev/null | grep -q true || break
    sleep 1
  done
  curl -sf "http://127.0.0.1:$p/health" >/dev/null || { docker logs --tail 30 "$SPEACHES" >&2; die "speaches did not come up"; }
  say "speaches: fetching $SPEACHES_STT_MODEL (once)"
  curl -sf -X POST "http://127.0.0.1:$p/v1/models/$SPEACHES_STT_MODEL" >/dev/null ||
    curl -sf "http://127.0.0.1:$p/v1/models/$SPEACHES_STT_MODEL" >/dev/null || die "speaches: could not fetch $SPEACHES_STT_MODEL"
}

# setup_voice turns on TTS, the speaker model and STT (whisper on the CPU, or the --speech
# remote), then waits until a synthesized phrase comes back as text through command-center, as
# a node would see it.
setup_voice() {
  local llm=llm cc=cc
  [ "$SPEECH" = local ] || setup_remote_stt
  if [ "$VOICE" != 1 ]; then
    [ "$SPEECH" != local ] || set_setting "$llm" stt.engine '"off"'
    return
  fi
  fetch_voice_models
  set_setting "$llm" tts.model "\"$CACHE/kokoro-multi-lang-v1_0\""
  set_setting "$llm" speaker.model "\"$CACHE/3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx\""
  set_setting "$llm" stt.model "\"$STT_FILE\""
  set_setting "$llm" stt.gpu_backend '"cpu"'
  set_setting "$llm" stt.gpu_layers 0
  # whisper-server's default is 4 threads: half the cores, at most 8, is ~1.5x faster on a
  # short command without taking the whole box.
  local threads=$(( $(getconf _NPROCESSORS_ONLN) / 2 ))
  [ "$threads" -gt 8 ] && threads=8
  [ "$threads" -lt 1 ] && threads=1
  set_setting "$llm" stt.extra_args "\"-t $threads\""
  [ "$SPEECH" != local ] || set_setting "$llm" stt.engine '"local"'
  local node_id=5eed0000-0000-4000-8000-00000000a0de node_key code stt_desc="$STT_MODEL on the CPU; the first start fetches whisper-server"
  case $SPEECH in
    fake) stt_desc="remote: tools/fakespeech" ;;
    speaches) stt_desc="remote: speaches, $SPEACHES_STT_MODEL" ;;
  esac
  node_key=$(json "d.get('nodes',{}).get('$node_id','')" <"$HOME_DIR/seed-dev-state.json")
  say "voice: warming TTS and STT ($stt_desc)"
  for _ in $(seq 1 120); do
    code=$(curl -s -o "$DIR/.warm.wav" -w '%{http_code}' -X POST "$(svc_url cc)/api/v0/media/tts/speak" \
      -H "X-API-Key: $node_id:$node_key" -H 'Content-Type: application/json' -d '{"text": "Testing one two three."}')
    if [ "$code" = 200 ]; then
      code=$(curl -s -o "$DIR/.warm.json" -w '%{http_code}' -X POST "$(svc_url cc)/api/v0/media/whisper/transcribe" \
        -H "X-API-Key: $node_id:$node_key" -F "file=@$DIR/.warm.wav;type=audio/wav")
      [ "$code" = 200 ] && break
    fi
    sleep 1
  done
  [ "$code" = 200 ] || die "voice: not ready after 2 minutes ($code: $(head -c 300 "$DIR/.warm.json" "$DIR/.warm.wav" 2>/dev/null | tr -d '\0'))"
  say "voice: up; heard \"$(json 'd["text"].strip()' <"$DIR/.warm.json")\" for \"Testing one two three.\""
  rm -f "$DIR/.warm.wav" "$DIR/.warm.json"
}

# role_emails prints SBX_EMAIL_ADMIN, _POWER and _MEMBER: the first member of the superuser's
# household with that role (admin: other than the superuser), as the household lists them.
role_emails() {
  local auth hh
  auth=$(svc_url auth)
  hh=$(curl -sf "$auth/households" -H "Authorization: Bearer $TOKEN" |
    json 'next((h["id"] for h in d if h.get("role") == "admin"), "")') || return 0
  [ -n "$hh" ] || return 0
  curl -sf "$auth/households/$hh/members" -H "Authorization: Bearer $TOKEN" | SBX_EMAIL=test@jarvisautomation.io python3 -c '
import json, os, sys
members = json.load(sys.stdin)
for role, var in (("admin", "ADMIN"), ("power_user", "POWER"), ("member", "MEMBER")):
    m = next((m for m in members if m.get("role") == role and m.get("email") != os.environ["SBX_EMAIL"]), None)
    if m:
        print("export SBX_EMAIL_" + var + "=" + m["email"])' || true
}

# lan_host is the address the LAN reaches this box on: $JARVIS_LAN_HOST, else the source address
# of the default route.
lan_host() {
  local h=${JARVIS_LAN_HOST:-}
  [ -n "$h" ] || h=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
  # macOS has no ip(8): the default route's interface, then its address.
  [ -n "$h" ] || h=$(ipconfig getifaddr "$(route -n get default 2>/dev/null | sed -n 's/.*interface: //p')" 2>/dev/null)
  [ -n "$h" ] && [ "$h" != 127.0.0.1 ] || return 1
  echo "$h"
}

write_env() {
  local node_id node_key
  node_id=5eed0000-0000-4000-8000-00000000a0de
  node_key=$(json "d.get('nodes',{}).get('$node_id','')" 2>/dev/null <"$HOME_DIR/seed-dev-state.json" || true)
  if [ "$PROFILE" = empty ]; then TOKEN=; else TOKEN=$(login); fi
  umask 077
  {
    echo "# scripts/sandbox $NAME ($(date -Iseconds)); source this file"
    echo "export JARVIS_SANDBOX=$NAME"
    echo "export JARVIS_HOME=$HOME_DIR"
    echo "export JARVIS_PORT_OFFSET=$(cat "$OFFSETF")"
    if [ "$LAN" = 1 ]; then
      echo "export SBX_LAN_HOST=$LAN_HOST"
      echo "export SBX_LAN_CONFIG=http://$LAN_HOST:$(port 7700)"
    fi
    for l in config auth logs cc llm whisper tts notifications recipes ocr admin; do
      n=$(tr '[:lower:]' '[:upper:]' <<<"$l")
      echo "export SBX_$n=$(svc_url "$l")"
    done
    echo "export SBX_MQTT=127.0.0.1:$(port 1884)"
    echo "export SBX_LLM_TAP=http://127.0.0.1:$(port 7799)"
    echo "export SBX_LLM_LOG=$DIR/llm.jsonl"
    if [ "$LLM" = scripted ]; then echo "export SBX_SCRIPTLLM=http://127.0.0.1:$(port 7798)"; fi
    if [ "$RELAY" = fake ]; then echo "export SBX_FAKERELAY=http://127.0.0.1:$(port 7797)"; echo "export SBX_PUSH_LOG=$DIR/pushes.jsonl"; fi
    case $RELAY in http*) echo "export SBX_RELAY=$RELAY" ;; esac
    if [ "$SPEECH" = fake ]; then echo "export SBX_FAKESPEECH=http://127.0.0.1:$(port 7796)"; echo "export SBX_SPEECH_LOG=$DIR/speech.jsonl"; fi
    if [ "$SPEECH" = speaches ]; then echo "export SBX_SPEACHES=http://127.0.0.1:$(port 7795)"; fi
    echo "export SBX_ADMIN_API_KEY=$(cat "$DIR/admin-api-key")"
    echo "export SBX_AUTH_ADMIN_TOKEN=$(cat "$DIR/auth-admin-token")"
    if [ "$VOICE" = 1 ]; then echo "export SBX_VOICE=$STT_MODEL"; fi
    if [ "$SIP" = 1 ]; then echo "export SBX_SIP_LANE=$DIR/sip/lane.env"; fi
    if [ "$PROFILE" = empty ]; then
      # Nobody to sign in as: first-run setup is still to do, with this one-time token
      # (the wizard's link is $SBX_ADMIN/setup#token=$SBX_SETUP_TOKEN).
      echo "export SBX_SETUP_TOKEN=$(cat "$HOME_DIR/setup-token")"
      return
    fi
    echo "export SBX_EMAIL=test@jarvisautomation.io"
    echo "export SBX_PASSWORD='DevPass123!'"
    echo "export SBX_TOKEN=$TOKEN"
    echo "export SBX_USER_ID=$(curl -sf "$(svc_url auth)/auth/me" -H "Authorization: Bearer $TOKEN" | json 'd["id"]')"
    # A seeded login per household role besides the superuser (scripts/seed-dev.py PEOPLE),
    # for scripts/screenshots --user; same password.
    role_emails
    echo "export SBX_NODE_ID=$node_id"
    echo "export SBX_NODE_KEY=$node_key"
  } >"$ENVF"
}

cmd_up() {
  mkdir -p "$HOME_DIR"
  pick_offset >"$OFFSETF.new" && mv "$OFFSETF.new" "$OFFSETF"
  [ -f "$DIR/admin-api-key" ] || head -c 24 /dev/urandom | base64 | tr -d '/+=' >"$DIR/admin-api-key"
  [ -f "$DIR/auth-admin-token" ] || head -c 24 /dev/urandom | base64 | tr -d '/+=' >"$DIR/auth-admin-token"

  if [ "$UI" = 1 ]; then
    say "building the admin UI"
    # VITE_UI_GALLERY adds the dev-only design-system gallery (/dev/ui) for screenshots; a
    # release build leaves it out.
    npm --prefix "$ROOT/web/admin" ci --silent && VITE_UI_GALLERY=1 npm --prefix "$ROOT/web/admin" run build --silent
  fi
  say "building jarvisd"
  local ldflags="-X main.version=$VERSION"
  [ -z "$TRUST_KEY" ] || ldflags="$ldflags -X github.com/alexberardi/jarvis-server/internal/update.extraTrustedKey=$TRUST_KEY"
  (cd "$ROOT" && CGO_ENABLED=0 go build -ldflags "$ldflags" -o "$DIR/jarvisd" ./cmd/jarvisd)
  (cd "$ROOT" && CGO_ENABLED=0 go build -o "$DIR/pipeline" ./tools/pipeline)
  [ "$LLM" != scripted ] || (cd "$ROOT" && CGO_ENABLED=0 go build -o "$DIR/scriptllm" ./tools/scriptllm)
  [ "$RELAY" != fake ] || (cd "$ROOT" && CGO_ENABLED=0 go build -o "$DIR/fakerelay" ./tools/fakerelay)
  [ "$SPEECH" != fake ] || (cd "$ROOT" && CGO_ENABLED=0 go build -o "$DIR/fakespeech" ./tools/fakespeech)
  echo "$LLM" >"$LLMF"
  echo "$RELAY" >"$DIR/relay-mode"
  if [ "$SINGLE_PORT" = 1 ]; then touch "$SINGLEF"; else rm -f "$SINGLEF"; fi

  cmd_stop
  local ui="" bind=127.0.0.1
  if [ "$LAN" = 1 ]; then
    LAN_HOST=$(lan_host) || die "--lan: could not tell this box's LAN address; set JARVIS_LAN_HOST"
    bind=0.0.0.0
    say "--lan: listening on every interface; the LAN reaches it at $LAN_HOST"
  fi
  [ -d "$ROOT/web/admin/dist/ui" ] && ui=$ROOT/web/admin/dist/ui
  say "starting on offset $(cat "$OFFSETF") (cc $(svc_url cc), admin :$(port 7710))"
  # The push relay is relay.url's env fallback, so it applies before seeding and on --profile
  # empty too; a test that sets relay.url itself overrides it.
  local relay_url=
  case $RELAY in
    fake)
      detach "$DIR/fakerelay" --listen "$bind:$(port 7797)" --log "$DIR/pushes.jsonl" >>"$DIR/fakerelay.log" 2>&1 </dev/null &
      echo $! >"$RELAYPID"
      relay_url=http://127.0.0.1:$(port 7797) ;;
    none) ;;
    *) relay_url=$RELAY ;;
  esac
  if [ "$SPEECH" = fake ]; then
    [ -f "$DIR/fakespeech-key" ] || echo "sk-fake-$(head -c 12 /dev/urandom | base64 | tr -d '/+=')" >"$DIR/fakespeech-key"
    FAKESPEECH_KEY=$(cat "$DIR/fakespeech-key") detach "$DIR/fakespeech" --listen "$bind:$(port 7796)" \
      --log "$DIR/speech.jsonl" >>"$DIR/fakespeech.log" 2>&1 </dev/null &
    echo $! >"$SPEECHPID"
  fi
  say "push relay: ${relay_url:-none}$([ "$RELAY" != fake ] || echo " (tools/fakerelay; pushes in $DIR/pushes.jsonl)")"
  # Every harness URL assumes the legacy ports unless --single-port asks for a fresh install's.
  local legacy=1
  [ "$SINGLE_PORT" = 0 ] || legacy=0
  RELAY_URL=$relay_url JARVIS_LEGACY_PORTS=$legacy JARVIS_HOST=$bind JARVIS_MDNS=0 JARVIS_NO_BROWSER=1 JARVIS_ADMIN_UI_DIR=$ui JARVIS_DEV_SPEAKER_HINTS=1 \
    ADMIN_API_KEY=$(cat "$DIR/admin-api-key") JARVIS_AUTH_ADMIN_TOKEN=$(cat "$DIR/auth-admin-token") \
    detach "$DIR/jarvisd" --home "$HOME_DIR" serve --port-offset "$(cat "$OFFSETF")" >>"$LOG" 2>&1 </dev/null &
  echo $! >"$PIDFILE"
  local upstream
  if [ "$LLM" = scripted ]; then
    detach "$DIR/scriptllm" --listen "$bind:$(port 7798)" --dir "$ROOT" --script e2e/llm/default.json \
      --log "$DIR/scriptllm-unmatched.jsonl" >>"$DIR/scriptllm.log" 2>&1 </dev/null &
    echo $! >"$SCRIPTPID"
    upstream=http://127.0.0.1:$(port 7798) INSTALLED_APP_ID= INSTALLED_APP_KEY=
  else
    load_creds || true
    upstream=$INSTALLED_LLM_URL
  fi
  JARVIS_TAP_APP_ID=$INSTALLED_APP_ID JARVIS_TAP_APP_KEY=$INSTALLED_APP_KEY \
    detach "$DIR/pipeline" tap --listen "127.0.0.1:$(port 7799)" --upstream "$upstream" --log "$DIR/llm.jsonl" \
    >>"$DIR/tap.log" 2>&1 </dev/null &
  echo $! >"$TAPPID"
  for _ in $(seq 1 60); do
    curl -sf "$(svc_url cc)/health" >/dev/null && break
    running || { tail -20 "$LOG" >&2; die "jarvisd exited (log: $LOG)"; }
    sleep 0.5
  done
  curl -sf "$(svc_url cc)/health" >/dev/null || die "not healthy after 30s (log: $LOG)"

  if [ "$PROFILE" = empty ]; then
    [ -f "$HOME_DIR/setup-token" ] || die "--profile empty: $HOME_DIR/setup-token is missing (was this sandbox seeded before? down --purge it first)"
    say "not seeding (--profile empty): first-run setup is still to do"
  else
    say "seeding ($PROFILE)"
    python3 "$ROOT/scripts/seed-dev.py" --home "$HOME_DIR" --base-url http://127.0.0.1 \
      --auth-url "$(svc_url auth)" --cc-url "$(svc_url cc)" --admin-port "$(port 7710)" \
      --profile "$PROFILE" >"$DIR/seed.log" 2>&1 || { tail -20 "$DIR/seed.log" >&2; die "seeding failed (log: $DIR/seed.log)"; }
    point_llm
    setup_voice
  fi
  if [ "$SIP" = 1 ]; then "$ROOT/scripts/sip-lane" up --name "$NAME" --offset "$(cat "$OFFSETF")"; fi
  write_env
  rm -f "$LANENVF"
  if [ "$LAN" = 1 ]; then
    # For the other machine: the same file with every loopback URL on the LAN address. Each one
    # listens there: jarvisd's services, the scripted model and the fake relay on $bind, MQTT on
    # every interface (its default). The LLM tap stays on loopback (only jarvisd calls it), so
    # SBX_LLM_TAP is left out.
    grep -v '^export SBX_LLM_TAP=' "$ENVF" | sed "s#127\.0\.0\.1#$LAN_HOST#g" >"$LANENVF"
    say "up: source $ENVF (on another machine: $LANENVF)"
    return
  fi
  say "up: source $ENVF"
}

# cmd_node_sim starts a simulated node (see the header) and prints its pairing code.
cmd_node_sim() {
  running || die "$NAME is not up"
  local sim=$DIR/simnode/$NODE_NAME pid run
  if [ -f "$sim/pid" ] && kill -0 "$(cat "$sim/pid")" 2>/dev/null; then
    die "node-sim $NODE_NAME is already running (pid $(cat "$sim/pid")); pick another --node-name or down the sandbox"
  fi
  rm -rf "$sim"
  mkdir -p "$sim/home"
  # The control socket's directory: short, since a unix socket path has ~100 bytes at most.
  run=$(mktemp -d "${TMPDIR:-/tmp}/jsim.XXXXXX")
  echo "$run" >"$sim/rundir"
  (cd "$ROOT" && CGO_ENABLED=0 go build -o "$DIR/jarvis-agent" ./cmd/jarvis-agent)
  # Its own HOME, XDG dirs and runtime dir, and none of this session's desktop (display, session
  # bus): its node.json, settings and control socket stay here, and it never touches this user's
  # files or a desktop agent they run. Stdin is the "y" the join question reads once a member
  # approved the code.
  local agent=$DIR/jarvis-agent creds=$sim/node.json h=$sim/home
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u XDG_SESSION_TYPE -u XDG_CURRENT_DESKTOP \
    HOME=$h XDG_CONFIG_HOME=$h/.config XDG_CACHE_HOME=$h/.cache XDG_DATA_HOME=$h/.local/share \
    XDG_STATE_HOME=$h/.local/state XDG_RUNTIME_DIR=$run \
    JARVIS_AGENT_CONTROL_SOCKET=$run/control.sock JARVIS_AGENT_BROWSER_SOCKET=$run/browser.sock \
    detach bash -c 'echo y | "$1" enroll --code --profile pi --no-browser --name "$2" --creds "$3" --server "$4" &&
      exec "$1" run --profile pi --voice=false --no-auto-update --creds "$3"' \
    simnode "$agent" "$NODE_NAME" "$creds" "http://127.0.0.1:$(port 7700)" >"$sim/agent.log" 2>&1 </dev/null &
  pid=$!
  echo "$pid" >"$sim/pid"
  # The code is the indented line after "approve this code" (pairWithCode in cmd/jarvis-agent).
  local code=
  for _ in $(seq 1 120); do
    code=$(sed -n '/approve this code/,/Waiting for approval/{s/^    \([A-Z0-9-]\{4,\}\)$/\1/p}' "$sim/agent.log")
    [ -n "$code" ] && break
    kill -0 "$pid" 2>/dev/null || { tail -20 "$sim/agent.log" >&2; die "node-sim: the agent exited (log: $sim/agent.log)"; }
    sleep 0.25
  done
  [ -n "$code" ] || { tail -20 "$sim/agent.log" >&2; die "node-sim: no pairing code after 30s (log: $sim/agent.log)"; }
  echo "$code" >"$sim/code"
  say "node-sim $NODE_NAME: waiting for approval of $code (log: $sim/agent.log)"
  echo "$code"
}

cmd_stop() {
  local p
  for p in "$DIR"/simnode/*/pid; do
    # The whole session: the enroll wrapper or the agent it became.
    [ -f "$p" ] && kill -- "-$(cat "$p")" 2>/dev/null || true
    rm -f "$p"
    [ -f "${p%/pid}/rundir" ] && rm -rf "$(cat "${p%/pid}/rundir")" "${p%/pid}/rundir"
  done
  if running; then
    local pid
    pid=$(cat "$PIDFILE")
    kill "$pid"
    for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
  fi
  rm -f "$PIDFILE"
  if tap_running; then kill "$(cat "$TAPPID")"; fi
  rm -f "$TAPPID"
  if scriptllm_running; then kill "$(cat "$SCRIPTPID")"; fi
  rm -f "$SCRIPTPID"
  if relay_running; then kill "$(cat "$RELAYPID")"; fi
  rm -f "$RELAYPID"
  if speech_running; then kill "$(cat "$SPEECHPID")"; fi
  rm -f "$SPEECHPID"
  if command -v docker >/dev/null && docker ps -aq --filter "name=^$SPEACHES\$" 2>/dev/null | grep -q .; then
    docker rm -f "$SPEACHES" >/dev/null 2>&1 || true
  fi
  if [ -f "$DIR/sip/lane.env" ]; then "$ROOT/scripts/sip-lane" down --name "$NAME" || true; fi
}

cmd_down() {
  cmd_stop
  if [ "$PURGE" = 1 ]; then rm -rf "$DIR"; say "$NAME stopped and deleted"; else say "$NAME stopped (data kept; --purge deletes it)"; fi
}

gpu_report() {
  command -v nvidia-smi >/dev/null || return 0
  echo "GPU:"
  nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader | sed 's/^/  used, total: /'
  nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader | while IFS=, read -r pid mem; do
    local args owner=other
    args=$(ps -o args= -p "$pid" 2>/dev/null | cut -c1-80)
    case $args in *"$SBX_ROOT"*) owner=sandbox ;; */var/lib/jarvisd/*|*.jarvisd/*) owner=installed ;; esac
    echo "  $owner $mem  $args"
  done
}

cmd_status() {
  if [ -f "$OFFSETF" ]; then
    if running; then echo "$NAME: up (pid $(cat "$PIDFILE"), offset $(cat "$OFFSETF"), cc $(svc_url cc), admin http://127.0.0.1:$(port 7710))"
    else echo "$NAME: down (offset $(cat "$OFFSETF"))"; fi
  else
    echo "$NAME: not created"
  fi
  if load_creds; then c="app client $INSTALLED_APP_ID"; else c="no app client in $CREDS"; fi
  if m=$(installed_model); then echo "installed jarvisd LLM: $INSTALLED_LLM_URL, $INSTALLED_LLM_LABEL = ${m%% *} ($c)"; else echo "installed jarvisd LLM: $INSTALLED_LLM_URL not answering ($c)"; fi
  if [ -f "$DIR/sip/lane.env" ]; then "$ROOT/scripts/sip-lane" status --name "$NAME"; fi
  gpu_report
}

case $CMD in
  up) LLM=${LLM:-shared}; cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  env) [ -f "$ENVF" ] || die "no $ENVF (scripts/sandbox up)"; cat "$ENVF" ;;
  logs) if [ "$FOLLOW" = 1 ]; then tail -f "$LOG"; else tail -100 "$LOG"; fi ;;
  llm) running || die "$NAME is not up"
       saved=$(cat "$LLMF" 2>/dev/null || echo shared)
       [ -z "$LLM" ] || [ "$LLM" = "$saved" ] || die "$NAME runs --llm $saved; switch with scripts/sandbox up --name $NAME --llm $LLM"
       LLM=$saved; point_llm ;;
  list) for d in "$SBX_ROOT"/*/; do [ -d "$d" ] && NAME=$(basename "$d") DIR=$d PIDFILE=$d/jarvisd.pid OFFSETF=$d/offset && \
          if running; then echo "$NAME up offset $(cat "$OFFSETF")"; else echo "$NAME down"; fi; done ;;
  node-sim) cmd_node_sim ;;
  *) die "unknown command $CMD (up, down, status, env, logs, llm, list, node-sim)" ;;
esac
