<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- jarvisd extracts its embedded sherpa-onnx/onnxruntime dylibs to its data directory and
	     dlopens them (purego). They carry the upstream ad-hoc signatures, not our Team ID, so the
	     hardened runtime's library validation would refuse to map them. See release.yml. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
