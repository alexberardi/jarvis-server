#!/usr/bin/env bash
# scripts/appclick-live: voice clicks (internal/agent/appclick) against a real LibreOffice Writer,
# in an isolated headless desktop (ELEMENT-LAYER-WORK.md slice 4b's live check).
#
#   scripts/appclick-live           run TestLiveLibreOffice on Writer, then Calc, each in a fresh
#                                   session; logs stay in the printed dirs
#
# Isolation, as scripts/desktop-shot: `env -i` so nothing of the user's session leaks in, its own
# XDG_RUNTIME_DIR under /tmp (a fresh Wayland socket), HOME, session bus (dbus-run-session) and
# accessibility bus, a headless sway that opens no display or input device, and a fresh
# LibreOffice profile. Nothing appears on the user's screen and no input reaches their desktop.
# Needs sway (system, or `scripts/desktop-shot deps` builds it into ~/.cache) and LibreOffice.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/jarvis-harness/desktop
SWAY_VER=1.12

say() { printf 'appclick-live: %s\n' "$*" >&2; }

# --- inside the isolated session (env -i … dbus-run-session) ------------------------------------
if [ "${1:-}" = __session ]; then
  pids=()
  # LibreOffice's launcher outlives a polite stop: stop it by its scratch profile, then force it.
  stop_office() {
    pkill -f "UserInstallation=file://$OUT/lo-profile" 2>/dev/null || true
    sleep 2
    pkill -9 -f "UserInstallation=file://$OUT/lo-profile" 2>/dev/null || true
  }
  cleanup() {
    stop_office
    for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done
    wait 2>/dev/null || true
  }
  trap cleanup EXIT
  cfg=$XDG_RUNTIME_DIR/sway.conf
  printf 'output HEADLESS-1 mode 1600x1000 position 0 0\nfocus_follows_mouse no\n' >"$cfg"
  WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman \
    "$SWAY" -c "$cfg" >"$OUT/sway.log" 2>&1 &
  pids+=($!)
  sock= ipc=
  for _ in $(seq 100); do
    sock=$(cd "$XDG_RUNTIME_DIR" && ls wayland-[0-9] 2>/dev/null | head -1 || true)
    ipc=$(ls "$XDG_RUNTIME_DIR"/sway-ipc.*.sock 2>/dev/null | head -1 || true)
    [ -n "$sock" ] && [ -n "$ipc" ] && break
    sleep 0.1
  done
  [ -n "$sock" ] && [ -n "$ipc" ] || { say "sway never started; see $OUT/sway.log"; exit 2; }
  export WAYLAND_DISPLAY=$sock SWAYSOCK=$ipc

  # The accessibility bus, switched on before LibreOffice starts: an app decides whether to join
  # it at startup.
  /usr/lib/at-spi-bus-launcher --launch-immediately >"$OUT/atspi.log" 2>&1 &
  pids+=($!)
  for _ in $(seq 50); do
    gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
      --method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled '<true>' >/dev/null 2>&1 && break
    sleep 0.1
  done
  # The registry, started here: in a bare session its D-Bus activation goes through systemd,
  # which isn't there ("Could not activate remote peer 'org.a11y.atspi.Registry': unit failed").
  /usr/lib/at-spi2-registryd >"$OUT/registryd.log" 2>&1 &
  pids+=($!)

  SAL_USE_VCLPLUGIN=gtk3 GDK_BACKEND=wayland soffice "--$APP" --norestore --nologo \
    --nofirststartwizard "-env:UserInstallation=file://$OUT/lo-profile" >"$OUT/soffice.log" 2>&1 &
  pids+=($!)

  set +e
  JARVIS_APPCLICK_LIVE=1 JARVIS_APPCLICK_APP=$APP "$OUT/appclick.test" -test.run '^TestLiveLibreOffice$' -test.v -test.count=1 2>&1 | tee "$OUT/test.log"
  rc=${PIPESTATUS[0]}
  set -e
  exit "$rc"
fi

# --- outside: build the test, then run it in a fresh session ------------------------------------
if command -v sway >/dev/null; then
  SWAY=$(command -v sway)
elif [ -x "$CACHE/sway-$SWAY_VER/bin/sway" ]; then
  SWAY=$CACHE/sway-$SWAY_VER/bin/sway
else
  say "no sway: install it, or run scripts/desktop-shot deps"; exit 2
fi
for c in soffice dbus-run-session gdbus /usr/lib/at-spi-bus-launcher /usr/lib/at-spi2-registryd; do
  command -v "$c" >/dev/null || [ -x "$c" ] || { say "missing $c"; exit 2; }
done

BUILD=$(mktemp -d /tmp/jac-build.XXXXXX)
(cd "$ROOT" && CGO_ENABLED=0 mise exec go@1.27 -- go test -c -o "$BUILD/appclick.test" ./internal/agent/appclick)

status=0
for APP in writer calc; do
  OUT=$(mktemp -d /tmp/jac.XXXXXX) # short: Unix socket paths are limited
  RT=$OUT/run
  mkdir -m 700 "$RT" "$OUT/home"
  cp "$BUILD/appclick.test" "$OUT/"
  say "$APP: logs and profile in $OUT"
  set +e
  env -i "PATH=$(dirname "$SWAY"):/usr/local/bin:/usr/bin:/bin" "HOME=$OUT/home" "TMPDIR=/tmp" \
    "XDG_RUNTIME_DIR=$RT" "XDG_CONFIG_HOME=$OUT/home/.config" "XDG_CACHE_HOME=$OUT/home/.cache" \
    XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland "JARVIS_APPCLICK_ISOLATED=$RT" \
    "SWAY=$SWAY" "OUT=$OUT" "APP=$APP" \
    timeout 180 dbus-run-session -- bash "$0" __session
  rc=$?
  set -e
  say "$APP: exit $rc"
  [ "$rc" = 0 ] || status=1
done
rm -rf "$BUILD"
exit "$status"
