#!/bin/sh
# postinst of the jarvisd .deb (01-no-cli-plan items 1.10 and 2.4).
#
# The package ships the binary at /usr/lib/jarvisd/jarvisd. `install-from-app` copies it to
# /usr/local/bin/jarvisd (dpkg doesn't own that copy, so the self-updater can swap it; a newer
# self-updated copy is kept), registers and starts the systemd unit, opens the firewall for the
# local network when a host firewall is active (decided Q4: LAN only, tagged for uninstall),
# and prints the setup link with a QR code for a headless install over SSH. Without systemd
# (a container) it installs the binary and says how to run it.
set -e

case "$1" in
configure)
  /usr/lib/jarvisd/jarvisd install-from-app --qr --allow-no-service
  ;;
esac

exit 0
