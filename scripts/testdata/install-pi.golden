## commands
apt-get update -q
env DEBIAN_FRONTEND=noninteractive apt-get install -y -q pulseaudio pulseaudio-module-bluetooth bluez rfkill iw hostapd dnsmasq device-tree-compiler alsa-utils
chown pi: /opt/jarvis-agent
dtc -q -W no-unit_address_vs_reg -I dts -O dtb -o /boot/firmware/overlays/respeaker-2mic-v2_0-overlay.dtbo /usr/local/share/jarvis-agent/respeaker-2mic-v2_0-overlay.dts
udevadm control --reload
rfkill unblock bluetooth
systemctl restart bluetooth
amixer -q -c seeed2micvoicec sset PCM 100% unmute
amixer -q -c seeed2micvoicec sset Line 2 unmute
amixer -q -c seeed2micvoicec sset Line DAC 115 unmute
amixer -q -c seeed2micvoicec sset Left Line Mixer DACL1 on
amixer -q -c seeed2micvoicec sset Right Line Mixer DACR1 on
amixer -q -c seeed2micvoicec sset HP 0 mute
amixer -q -c seeed2micvoicec sset HP DAC 0 mute
amixer -q -c seeed2micvoicec sset HPCOM 0 mute
amixer -q -c seeed2micvoicec sset HPCOM DAC 0 mute
amixer -q -c seeed2micvoicec sset PGA 49%
amixer -q -c seeed2micvoicec sset Left PGA Mixer Line1L on
amixer -q -c seeed2micvoicec sset Right PGA Mixer Line1R on
amixer -q -c seeed2micvoicec cset name=ADC HPF Cut-off 1
alsactl store
usermod -aG audio pi
usermod -aG spi pi
usermod -aG gpio pi
usermod -aG i2c pi
usermod -aG bluetooth pi
loginctl enable-linger pi
systemd-tmpfiles --create --prefix /var/log/journal
systemctl restart systemd-journald
journalctl --flush
sysctl -q -w vm.swappiness=1
fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
systemctl stop hostapd dnsmasq
systemctl disable hostapd dnsmasq
systemctl mask hostapd dnsmasq
nmcli connection modify jarvis-Home wifi.powersave 2
nmcli device reapply wlan0
iw dev wlan0 set power_save off
nmcli connection modify preconfigured connection.autoconnect no
nmcli connection modify jarvis-Home connection.autoconnect yes connection.autoconnect-priority 999
systemctl daemon-reload
systemctl enable --now jarvis-net-watchdog.timer
systemctl daemon-reload
## boot/firmware/config.txt
[all]
dtparam=audio=off
#dtoverlay=wm8960-soundcard # replaced for ReSpeaker v2.0
dtoverlay=respeaker-2mic-v2_0-overlay
dtparam=spi=on
dtparam=i2c_arm=on
## etc/asound.conf
# --- Playback -----------------------------------------------------------
pcm.output {
    type pulse
}

# --- Capture ------------------------------------------------------------
pcm.dsnoopmic_hw {
    type dsnoop
    ipc_key 87654321
    slave {
        pcm "hw:CARD=seeed2micvoicec,DEV=0"
        channels 2
        rate 48000
        format S16_LE
        # ~85 ms of ring buffer, so the wake word never scores stale audio (N:install.sh).
        period_size 1024
        buffer_size 4096
    }
}

pcm.dsnoopmic {
    type plug
    slave.pcm "dsnoopmic_hw"
}

# --- Default split: playback via PA, capture direct --------------------
pcm.!default {
    type asym
    playback.pcm "output"
    capture.pcm "dsnoopmic"
}

ctl.!default {
    type pulse
}
## etc/bluetooth/main.conf
[General]
#Name = BlueZ
Class = 0x240404

[Policy]
#AutoEnable=true
## etc/fstab
proc /proc proc defaults 0 0
/swapfile none swap sw 0 0
## etc/modprobe.d/alsa-base.conf
options snd-soc-tlv320aic3x index=0
## etc/pulse/default.pa.d/97-jarvis-hat-sink.pa
.nofail
load-module module-alsa-sink device=hw:CARD=seeed2micvoicec,DEV=0 sink_name=jarvis_output rate=48000 tsched=0
set-default-sink jarvis_output
## etc/pulse/default.pa.d/98-jarvis-stream-restore.pa
.nofail
unload-module module-stream-restore
load-module module-stream-restore restore_device=false restore_muted=false restore_volume=false
## etc/pulse/default.pa.d/99-jarvis-no-suspend.pa
.nofail
unload-module module-suspend-on-idle
## etc/sudoers.d/jarvis-agent
# Written by jarvis-server scripts/install-pi.sh; do not edit by hand.
# What the Go node (jarvis-agent.service, User=pi) may run as root.
# The HAT button (3 s held) and the admin's reboot.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot
pi ALL=(root) NOPASSWD: /sbin/poweroff, /usr/sbin/poweroff, /sbin/reboot, /usr/sbin/reboot
pi ALL=(root) NOPASSWD: /usr/bin/systemctl restart jarvis-agent, /usr/bin/systemctl restart jarvis-agent.service
# A crash loop (a self-update's broken release) hits the unit's start limit; the rollback's restart needs it reset.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl reset-failed jarvis-agent, /usr/bin/systemctl reset-failed jarvis-agent.service
# Not yet, added with the step that needs them (go-pi-node.md §7):
# TODO(phase 4.4, provisioning AP): NetworkManager, nmcli (and hostapd/dnsmasq only if the NM AP fails).
# TODO(parity 5.6, packages): the apt and post-install wrappers.
# TODO(the mixer self-heal port, N:utils/audio_volume.py): jarvis-alsa-store.
## etc/sysctl.d/99-jarvis-node.conf
# Keep the jarvis node's working set resident in RAM: SD-card swap is slow and causes 7-8 s wakes
# after idle. 1 (not 0) keeps swap as a last-resort OOM safety valve.
vm.swappiness=1
## etc/systemd/journald.conf.d/jarvis.conf
# Jarvis node: a persistent, size-capped journal, so a wedge or a network drop can still be read
# after the reboot.
[Journal]
Storage=persistent
SystemMaxUse=200M
SystemKeepFree=100M
SystemMaxFileSize=20M
## etc/systemd/system/jarvis-agent.service
# Written by jarvis-server scripts/install-pi.sh; do not edit by hand.
[Unit]
Description=Jarvis voice node (Go)
After=network-online.target sound.target
Wants=network-online.target
# One node owns the HAT: starting this stops the Python node, and starting it stops this.
Conflicts=jarvis-node.service
StartLimitBurst=10
StartLimitIntervalSec=1800

[Service]
User=pi
Group=pi
ExecStart=/opt/jarvis-agent/jarvis-agent run --profile pi --voice --voice-input dsnoopmic --voice-output output --wake-models /usr/local/share/jarvis-agent/openwakeword
WorkingDirectory=/home/pi
Restart=always
RestartSec=5
TimeoutStopSec=10
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
SyslogIdentifier=jarvis-agent

[Install]
WantedBy=multi-user.target
## etc/systemd/system/jarvis-net-watchdog.service
# Written by jarvis-server scripts/install-pi.sh; do not edit by hand.
[Unit]
Description=Jarvis node network self-heal (recovers wlan0 from power-save / association loss)
# Run after the network stack is up; the watchdog tolerates "no network yet"
# on its own (it only escalates after FAIL_* consecutive checks and never
# reboots until it has actually been online this boot).
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=oneshot
User=root
# One check per invocation; all run-state lives in tmpfs (resets on reboot,
# which is the boot-loop guard). See /usr/local/sbin/jarvis-net-watchdog for the
# escalation ladder and why each threshold is where it is.
ExecStart=/usr/local/sbin/jarvis-net-watchdog
# Tunables (consecutive ~60s checks before each escalation step):
Environment=NETWD_IFACE=wlan0
Environment=NETWD_FAIL_REAPPLY=3
Environment=NETWD_FAIL_BOUNCE=4
Environment=NETWD_FAIL_REBOOT=6
# Don't reboot in the first MIN_UPTIME seconds even if it looks down — gives
# WiFi/NetworkManager time to associate on a cold boot.
Environment=NETWD_MIN_UPTIME=120
# Persistent reboot-rate cap so a flapping link can't reboot-loop the node:
# at most NETWD_REBOOT_MAX reboots per NETWD_REBOOT_WINDOW seconds.
Environment=NETWD_REBOOT_MAX=3
Environment=NETWD_REBOOT_WINDOW=3600
SyslogIdentifier=jarvis-net-watchdog
StandardOutput=journal
StandardError=journal
## etc/systemd/system/jarvis-net-watchdog.timer
# Written by jarvis-server scripts/install-pi.sh; do not edit by hand.
[Unit]
Description=Run the Jarvis node network self-heal every 60s

[Timer]
# First check 90s after boot (lets NetworkManager associate), then every 60s.
OnBootSec=90
OnUnitActiveSec=60
AccuracySec=10s
# Liveness watching, not a missed-job catch-up.
Persistent=false
Unit=jarvis-net-watchdog.service

[Install]
WantedBy=timers.target
## etc/udev/rules.d/89-jarvis-hat-pulse-ignore.rules
SUBSYSTEM=="sound", KERNEL=="card*", ATTR{id}=="seeed2micvoicec", ENV{PULSE_IGNORE}="1"
